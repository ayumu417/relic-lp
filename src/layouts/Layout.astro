---
import "../assets/scss/style.scss";

const BaseUrl = new URL(Astro.url.pathname, Astro.site);
const { PageTitle = "ReLic", PageDescription = "description" } = Astro.props;

// Google Fonts URLを変数化して管理
const googleFontUrl = "https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Noto+Serif+JP:wght@700&display=swap";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="format-detection" content="telephone=no, email=no, address=no" />

    <!-- meta -->
    <title>{PageTitle}</title>
    <meta name="description" content={PageDescription} />
    <link rel="canonical" href={BaseUrl} />

    <!-- OGP -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={BaseUrl} />
    <meta property="og:site_name" content="" />
    <meta property="og:title" content={PageTitle} />
    <meta property="og:description" content={PageDescription} />
    <meta property="og:image" content={`${BaseUrl}assets/img/settings/ogp.jpg`} />

    <!-- icon -->
    <link rel="icon" type="image/svg+xml" href={`${BaseUrl}assets/img/settings/favicon.svg`} />
    <link rel="icon" href={`${BaseUrl}assets/img/settings/favicon.ico`} />
    <link rel="apple-touch-icon" href={`${BaseUrl}assets/img/settings/favicon.png`} />

    <!-- web fonts (非同期読み込み・非ブロック化) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={googleFontUrl} />
    <link
      rel="stylesheet"
      href={googleFontUrl}
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link rel="stylesheet" href={googleFontUrl} />
    </noscript>

    <!-- css -->
  </head>
  <body>
    <div id="body_inner">
      <slot />

      <script>
        import "../assets/js/script";
      </script>
    </div>
  </body>
</html>