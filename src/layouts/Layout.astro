---
import Img from "../components/ImgLoader.astro";
import "../assets/scss/style.scss";

const BaseUrl = new URL(Astro.url.pathname, Astro.site);
const { PageTitle = "title", PageDescription = "description" } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover"
    />
    <meta
      name="format-detection"
      content="telephone=no, email=no, address=no"
    />

    <!-- meta -->
    <title>{PageTitle}</title>
    <meta name="description" content={PageDescription} />
    <link rel="canonical" href={BaseUrl} />

    <!-- OGP -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={BaseUrl} />
    <meta property="og:site_name" content="調光スルーカーテン「スリーヌ」" />
    <meta property="og:title" content={PageTitle} />
    <meta property="og:description" content={PageDescription} />
    <meta
      property="og:image"
      content={`${BaseUrl}assets/img/settings/ogp.jpg`}
    />

    <!-- icon -->
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${BaseUrl}assets/img/settings/favicon.svg`}
    />
    <link rel="icon" href={`${BaseUrl}assets/img/settings/favicon.ico`} />
    <link
      rel="apple-touch-icon"
      href={`${BaseUrl}assets/img/settings/favicon.png`}
    />

    <!-- web fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Noto+Serif+JP:wght@700&display=swap"
      rel="stylesheet"
    />

    <!-- css -->
  </head>
  <body>
    <div id="body_inner">
      <slot />

      <script>
        import { initCommonScripts } from "../assets/js/script";

        initCommonScripts();
      </script>
    </div>
  </body>
</html>
