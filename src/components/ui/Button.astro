---
// ボタンコンポーネントのProps型定義
export interface Props {
  href?: string;
  class?: string;
  color?: "black" | "white" | "magenta" | "blue" | "beige"; //色のバリエーションを定義
  [key: string]: any; // 任意のHTML属性を受け取れるようにする
}

// Propsの抽出。デフォルトカラーは "black"
const { text, href, class: className, color = "black", ...rest } = Astro.props;

// 選択された色に基づく修飾子クラスを生成（例: "button--white"）
const colorClass = `button--${color}`;
---

<!-- hrefの有無によってリンク(a)かブロック(div)かを切り替え -->
{
  href ? (
    <a href={href} class:list={["button", colorClass, className]} {...rest}>
      <slot />
    </a>
  ) : (
    <div class:list={["button", colorClass, className]} {...rest}>
      <slot />
    </div>
  )
}

<style lang="scss">
  .button {
    /* カラーバリエーション管理用のCSS変数（デフォルトは黒背景・白文字） */
    --bg_color: var(--color-black02);
    --text_color: var(--color-white);
    --border_color: var(--color-black02);
    
    /* ボタンの基本スタイル */
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 33rem;
    height: auto;
    min-height: 5.6rem;
    padding: 0.5em 2.5em 0.62em;
    margin: 0 auto;
    background: var(--bg_color);
    color: var(--text_color);
    border: 2px solid var(--border_color);
    border-radius: 10em;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
    transition: 0s;

    /* スマートフォンサイズの調整 */
    @include media_max(sp) {
      width: 25rem;
      min-height: 4.8rem;
      padding: 0.2em 0.7em 0.4em 0.2em;
      font-size: 1.3rem;
    }

    /* ホバー時の反転エフェクト */
    &:hover {
      background: var(--text_color);
      color: var(--bg_color);
      filter: brightness(1.1);
      opacity: 1;
    }

    /* ボタン右側の矢印（くの字）アイコン描画 */
    &::after {
      content: "";
      position: absolute;
      top: 50%;
      right: 1.6em;
      transform: translateY(-50%) rotateX(-35deg) rotate(-45deg);
      width: 0.7em;
      height: auto;
      aspect-ratio: 1/1;
      border: 2px solid var(--text_color);
      border-top: 0;
      border-left: 0;
    }
    
    /* ホバー時は矢印の色も反転させる */
    &:hover::after {
      border-color: var(--bg_color);
    }

    // 色の設定（各修飾子クラスでCSS変数を上書きしてカラーを変更）
    &--white {
      --bg_color: var(--color-white);
      --text_color: var(--color-black02);
      --border_color: var(--color-white);
    }
    &--magenta {
      --bg_color: var(--color-magenta01);
      --text_color: var(--color-white);
      --border_color: var(--color-magenta01);
    }
    &--beige {
      --bg_color: var(--color-dark_beige01);
      --text_color: var(--color-black02);
      --border_color: var(--color-dark_beige01);

      /* beigeカラー特有のホバー設定（背景色維持、文字色白へ） */
      &:hover {
        --bg_color: var(--color-dark_beige01);
        --text_color: var(--color-white);
        --border_color: var(--color-dark_beige01);
        background: var(--text_color);
        filter: brightness(1);
      }
    }
    &--blue {
      --bg_color: var(--color-deep_blue01);
      --text_color: var(--color-white);
      --border_color: var(--color-deep_blue01);
    }
  }
</style>