---
export interface Props {
  text: string;
  href?: string;
  class?: string;
  color?: "black" | "white" | "pink" | "blue" | "beige"; //色のバリエーションを定義
  [key: string]: any; // 任意のHTML属性を受け取れるようにする
}

const { text, href, class: className, color = "black", ...rest } = Astro.props;

const colorClass = `button--${color}`;
---

{
  href ? (
    <a href={href} class:list={["button", colorClass, className]} {...rest}>
      {text}
    </a>
  ) : (
    <div class:list={["button", colorClass, className]} {...rest}>
      {text}
    </div>
  )
}

<style lang="scss">
  .button {
    --bg_color: var(--color-black01);
    --text_color: var(--color-white);
    --border_color: var(--color-black02);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 33rem;
    height: auto;
    min-height: 5.6rem;
    padding: 0.5em 2.5em 0.6em;
    margin: 0 auto;
    background: var(--bg_color);
    color: var(--text_color);
    border: 2px solid var(--border_color);
    border-radius: 10em;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.6;
    transition: 0s;

    @include media_max(sp) {
      width: 25rem;
      min-height: 4.8rem;
      padding: 0.2em 0.2em 0.4em;
      font-size: 1.3rem;
    }

    &:hover {
      background: var(--text_color);
      color: var(--bg_color);
      filter: brightness(1.1);
      opacity: 1;
    }

    &::after {
      content: "";
      position: absolute;
      top: 50%;
      right: 1.6em;
      transform: translateY(-50%) rotateX(-35deg) rotate(-45deg);
      width: 0.7em;
      height: auto;
      aspect-ratio: 1/1;
      border: 2px solid var(--text_color);
      border-top: 0;
      border-left: 0;
    }
    &:hover::after {
      border-color: var(--bg_color);
    }

    //　色の設定
    &--white {
      --bg_color: var(--color-white);
      --text_color: var(--color-black02);
      --border_color: var(--color-white);
    }
    &--beige {
      --bg_color: var(--color-dark_beige01);
      --text_color: var(--color-black02);
      --border_color: var(--color-dark_beige01);

      &:hover {
        --bg_color: var(--color-dark_beige01);
        --text_color: var(--color-white);
        --border_color: var(--color-dark_beige01);
        background: var(--text_color);
        filter: brightness(1);
      }
    }
    &--blue {
      --bg_color: var(--color-deep_blue01);
      --text_color: var(--color-white);
      --border_color: var(--color-deep_blue01);
    }
  }
</style>
