---
import Img from "../utils/ImgLoader.astro";

interface Props {
  headingText: string; //en画像の下に表示する見出し
  imgSrc: string; //enの画像を指定する
  imgWidth?: number; //enの画像の幅
  imgAlt?: string; //enの画像のalt
  align?: "center" | "right" | "left"; // alignの種類を指定（center, right, または指定なし）
}

const {
  headingText,
  imgSrc,
  imgWidth = 180,
  imgAlt,
  align = "left", // 何も指定されなかった場合は 'left' をデフォルトにする
} = Astro.props;

// alignの値に応じて modifier クラス（--center や --right）を生成
// 'left' の場合は modifier を付けない
const modifierClass = align !== "left" ? `section_header--${align}` : "";

// 最終的なクラス名を結合（例: "section_header section_header--center"）
const wrapperClass = `section_header ${modifierClass}`.trim();
---

<div class={wrapperClass}>
  <span class="section_header__en">
    <Img img={{ src: imgSrc }} width={imgWidth} alt={imgAlt} />
  </span>
  <h2 class="section_header__heading">{headingText}</h2>
</div>

<style lang="scss">
  .section_header {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    width: 100%;
    margin: 0 0 4.7rem;
    font-size: 1em;
    z-index: 10;

    @include media_max(sp) {
      font-size: 1.2rem;
      margin-bottom: 3.2rem;
    }

    &--left {
      align-items: flex-start;
    }

    &--center {
      align-items: center;
    }

    &--right {
      align-items: flex-end;
    }

    &__en {
      width: fit-content;
      margin: 0 0;
      line-height: 1;
      font-size: 4rem;

      :global(img) {
        width: auto;
        max-width: 100%;
        height: 4.6rem;
        object-fit: contain;

        @include media_max(sp) {
          height: 3.4rem;
        }
      }
    }

    &__heading {
      width: fit-content;
      margin: 1.4em 0 0;
      font-size: 1.4rem;
      font-weight: 700;
      line-height: 1.2;
    }

    &::after {
      content: "";
      display: block;
      margin: 3.2rem 0 0;
      width: 14rem;
      height: 0.3rem;
      background: var(--color-deep_blue01);
      @include media_max(sp) {
        margin-top: 2.6rem;
        width: 10rem;
        height: 0.4rem;
      }
    }
  }
</style>
