---
import Img from "../utils/ImgLoader.astro";
import SectionHeader from "../ui/SectionHeader.astro";

/**
 * 人材紹介を配列で管理
 *
 * img:人物画像のパス（推奨アスペクト比：1/1）
 * name: `名前`,
 * position: `役職等`,
 * introduction: `紹介文`,
 */

const experts = [
  {
    img: `people__expert_img001.jpg`,
    position: `代表取締役CEO｜Founder`,
    name: `北嶋 貴朗`,
    introduction: `埼玉県立川越高等学校・慶應義塾大学を卒業後、組織変革や新規事業に特化したベンチャーファームにて中小・ベンチャー企業から大企業まで幅広く新規事業開発や組織変革を支援した後、ITメガベンチャーであるDeNAに入社。新規事業開発や事業戦略/事業企画の立案、大企業とのオープンイノベーションの責任者として数々の事業の創出から成長までを担う責任者を歴任し、100億円規模まで拡大。2015年に株式会社Relicを創業し、国内シェアNo.1の新規事業開発支援・共創実績を持つ事業共創プラットフォームに成長させる。`,
  },
  {
    img: `people__expert_img002.jpg`,
    position: `代表取締役CTO ｜ Co-Founder`,
    name: `大庭 亮`,
    introduction: `奈良先端科学技術大学院大学 情報科学研究科に在学中、産業技術総合研究所の技術研修生としてロボット工学の研究やロボット開発に従事した後、DeNAに入社。EC事業領域の新規事業・新規サービスや大手小売業との協働事業であるECサイトやショッピングモールの開発・運用の責任者としてリード。その後、100万人以上のユーザーが利用するスマートフォンアプリの開発や新規事業の開発リーダーを経験。2015年より複数のスタートアップのサービス開発や運用支援、及び技術アドバイザリーに従事した後、2016年、株式会社Relicに参画し、取締役CTOに就任。`,
  },
  {
    img: `people__expert_img003.jpg`,
    position: `取締役CRO ｜Co-Founder`,
    name: `大丸 徹也`,
    introduction: `慶應義塾大学卒業後、フューチャーアーキテクトにてITコンサルティングやシステム開発のPMを多数経験し、大手流通小売業の大規模システム刷新プロジェクトでは要件定義から保守/運用までプロジェクトリーダーとして推進。その後、DeNAに入社し、主にEC事業領域での新規事業や大手小売業とのオープンイノベーションによる新規事業の運営責任者を歴任。2015年に独立し、大手出版社や大手IT/通信事業者、EC事業者やスタートアップへのコンサルティングやハンズオンでの経営支援など幅広く活動。2016年に株式会社Relicに参画し、取締役COOに就任。`,
  },
  {
    img: `people__expert_img004.jpg`,
    position: `取締役CFO`,
    name: `中村 秀造`,
    introduction: `立命館大学経営学部を卒業後、三井住友銀行に入社し、コーポレートファイナンスに従事。その後、デザイン系ベンチャーにて営業マーケティングチームの統括を行いつつ上場準備に関する証券会社及び監査法人対応業務に従事。 2022年より株式会社Relicに入社。自社プロダクト「ENjiNE」の不動産投資型クラウドファンディング構築SaaS部門における事業運営や急成長を牽引。2023年8月株式会社3rd Economyを共同創業し、取締役に就任。 2024年7月より、現職。宅地建物取引士。`,
  },
  {
    img: `people__expert_img005.jpg`,
    position: `上級執行役員｜イノベーションマネジメント事業部長`,
    name: `佐々木 亜衣`,
    introduction: `東京大学 経済学部卒業後、外資系広告代理店に入社。AEとしてクライアントのマーケティング戦略立案から広告制作・出稿、新製品開発企画などマーケティング活動全般を支援。 その後、博報堂グループにて、新規事業開発組織の立ち上げを行う。所属部門のスピンオフに伴い、転籍。大手企業に対する新規事業開発コンサルティングに従事。事業開発プロジェクトの伴走から人事制度改革・人材育成まで、新規事業開発のボトルネックを解消し、効率よくプロジェクトを進行するための支援を幅広く実施。 `,
  },
  {
    img: `people__expert_img006.jpg`,
    position: `執行役員｜Co-Founder プロダクトディスカバリー<br>事業部長`,
    name: `黒木 裕貴`,
    introduction: `横浜国立大学卒業後、大手ITコンサルティングファームで法人向けシステム開発を経験し、サイバーエージェントグループでソーシャルゲームやSNS、iOSアプリ開発に従事。その後DeNAでEC・SNS系サービスの開発やUI設計、iOSアプリをリード。2015年に独立し、スタートアップや大手IT企業のUIデザイン、フロントエンド・ネイティブアプリ開発を支援する傍ら、自らサービスを開発・運営。2016年にRelicへ参画し、CCOとして自社・新規サービスのUI設計・開発を担当。デザイン思考を活用したサービス開発を強みとし、2021年に事業部を新設。現在はプロダクトディスカバリー事業部長を務める。`,
  },
  {
    img: `people__expert_img007.jpg`,
    position: `執行役員｜イノベーションマネジメント事業部 VP`,
    name: `奈良 一弘`,
    introduction: `中央大学卒業後、株式会社ベイカレント・コンサルティングへ入社。大手通信キャリア会社の大規模モバイルネットワークの設計改善プロジェクトでは、より低コストで高性能なネットワークの実現に向けて提案活動を続け、継続的に複数案件を獲得/遂行。その後、フューチャーアーキテクト株式会社へ入社。大手化粧品会社のECサイト及びフルフィルメントサービスを支える基幹システムを24時間365日で支え、高品質のサービス提供を約5年間継続してグロースを実現。2019年1月にRelicに参画。インキュベーションとアクセラレーションの双方で成果を残す。`,
  },
  {
    img: `people__expert_img008.jpg`,
    position: `執行役員｜イノベーションマネジメント事業部 VP`,
    name: `土谷 勇太郎`,
    introduction: `岩手大学農学部農林環境科学科を卒業後、大手メーカーに入社。その後、M&Aコンサルティング会社に転職し、2018年にM&Aコンサルティング・プラットフォーム事業を手掛ける「株式会社ALIVAL(現：M&Aナビ)」に共同創業メンバーとして立ち上げに参画。上場企業や国内外ファンドによる、中堅企業やスタートアップ企業等の買収やカーブアウトの実行支援に従事。Relicでは大企業向けの新規事業創出のための、制度・運用設計、ボトムアップやトップダウンの新規事業戦略・方針の策定、スタートアップM＆AやCVCの戦略・実行支援等、幅広い領域で支援を推進。`,
  },
  {
    img: `people__expert_img009.jpg`,
    position: `執行役員｜ビジネスクリエイション事業部 事業部長`,
    name: `丹野 渉`,
    introduction: `岩手大学電気電子情報システム工学専攻を卒業後、半導体商社に入社。技術営業として海外半導体製品の販売・マーケティング、ハード・ソフトウェア開発に従事し、オートモーティブ・IoT領域の経験を積む。その後、アクセンチュアにて通信・製造業界の技術戦略策定・新規事業開発を支援。独立後はベンチャー企業の経営・事業開発、人事制度・人材評価を支援し、Relicに事業プロデューサーとして参画。事業戦略策定やEC事業立ち上げ・推進等を担い、2025年より現職。岩手大学地域協創教育コーディネーターも務める。`,
  },
  {
    img: `people__expert_img010.jpg`,
    position: `執行役員｜エッジインキュベーション事業部長`,
    name: `永渕 貴煕`,
    introduction: `横浜国立大学在学中に新卒採用支援事業を創業し、その後HR系スタートアップでCOOとして事業立ち上げを牽引。2016年よりIT・広告系スタートアップで新規事業部の立ち上げを事業部長として主導し、独立系コンサルファームでは大手SIerの参入市場選定・戦略立案等の新規事業案件を担当。2020年にRelicへ参画し、大企業の0-1フェーズの案件を複数リードし、事業化・カーブアウトを実現。現在は「IDEATION Cloud」の責任者や、支援を通じて立ち上げた素材系大企業発ベンチャーの取締役を兼務し、2024年より現職。`,
  },
  {
    img: `people__expert_img011.jpg`,
    position: `執行役員｜グローカルイノベーション事業部長`,
    name: `大西 圭佑`,
    introduction: `神戸大学大学院にて、マーケティングや消費者行動論、イノベーション等を研究すると同時に、メーカーを中心とした国内外企業へのコンサルティング支援を行い、学問と実務の融合を推進。2020年にRelic新卒1期生として入社後、新規事業の戦略・方針策定から伴走支援まで一気通貫で推進。2022年に島根拠点を立ち上げ、自治体と連携して起業エコシステム構築や次世代人材育成に従事。2023年から地方拠点・地域創生プロジェクトの全体責任者を務め、2024年にはグローカルイノベーション事業部を立ち上げ。地域特性に応じた地域創生を推進中。`,
  },
  {
    img: `people__expert_img012.jpg`,
    position: `執行役員｜ディープテックイノベーションセンター長`,
    name: `金子 佳市`,
    introduction: `国立大学法人 東京農工大学 理事付/ 大阪工業大学 客員准教授/ 立教大学 ビジネスデザイン研究所 特任研究員/ 大阪工業大学大学院およびグロービス経営大学院大学を修了。 修士(工学)、経営学修士(専門職)<br>現在、立命館大学大学院 テクノロジー・マネジメント研究科 博士課程後期課程に在籍。 新卒で大手電機メーカーに入社し、パワーエレクトロニクス領域の開発および経営企画に従事。 その後、独立系ベンチャーキャピタル、複数のスタートアップ、ブティックファームの創業・経営に携わり、現在に至る。 これまで300件以上の技術経営支援に従事。`,
  },
  {
    img: `people__expert_img013.jpg`,
    position: `執行役員 ｜新規事業開発室長`,
    name: `土屋 益雄`,
    introduction: `大学卒業後、中小企業向けコンサルティング会社に入社。2004年にDeNAへ入社し、大手レコード会社との新規事業の立ち上げ・グロースを担当後、モバゲータウンで小説・音楽等の企画立ち上げを推進後、DeNAトラベルで海外オンライン旅行事業のマーケティング・企画編集責任者として事業グロースや新規メディア立ち上げを推進。モバオクで事業企画・マーケティングを担当。2016年にKDDIコマースフォワード（現auコマース＆ライフ）へ執行役員として参画。2019年のLUXAとの合併後、戦略・管理部門責任者を経て2020年に取締役就任。2023年に株式会社Relicへ参画。`,
  },
  {
    img: `people__expert_img014.jpg`,
    position: `執行役員｜プロダクトディベロップメント事業部長`,
    name: `河村 太樹`,
    introduction: `筑波大学大学院コンピュータサイエンス専攻修了後、ユナイテッド株式会社に入社。バックエンド開発・インフラ構築に従事し、3年間で約100サービスをリリース。その大半でリードエンジニアを務め、スケジュール調整や仕様策定・調整まで幅広く経験。その後、大手IT企業でインフラエンジニア・SREとして従事し、フリーランスとして複数のスタートアップやRelicで開発・インフラ構築・技術アドバイザリーを経験。2021年に正社員としてRelic参画後、プロジェクト横断でシステム改善を担うテクノロジープラットフォームグループを新設。プロダクトや全社の成長に貢献。`,
  },
  {
    img: `people__expert_img015.jpg`,
    position: `執行役員｜テックブリッジ部長`,
    name: `成宮 吉将`,
    introduction: `東京理科大学電気工学研究科卒業後、NECに入社。大手通信企業向け提案部署のエンジニアとして、様々なプロジェクトでネットワーク設計・設定を担当。新規サービスの実証実験・開発にも携わり、スマートフォンアプリの要件定義・検証を経験。2019年よりRelicに参画し、「Throttle」の要件定義・フロントエンド開発をリードし国内シェアNo.1へ成長させる。2021年には新規事業のプロトタイピング・MVP開発を担うグループを立ち上げ、2025年より新規事業向けシステム提案部署の責任者に就任。構想段階から技術支援を行い、最短でのMVP実装と事業成長の確度向上を実現。`,
  },
  {
    img: `people__expert_img016.jpg`,
    position: `執行役員 ｜x-AI事業部長`,
    name: `臺 健太郎`,
    introduction: `同志社大学経済学部卒業後、国家公務員として省庁で勤務した後、東京都庁、福島県庁などで政策立案・施策推進に従事し、国・自治体双方で制度設計と実務を経験。その後Relicに入社し、クラウドファンディング・ECプラットフォーム開発でリードエンジニアを務め、iOS/Androidアプリのバックエンド・インフラ開発も牽引。SREを主戦場とし、新規事業開発を強みとする。現在はx-AI事業部長としてクラウド・AI・ハードウェアを活用したソリューション提供を担う。2023年にPro3Labを設立しCEOに就任。RubyWorld Conference 2022登壇、AWS公式認定資格を複数保有。`,
  },
  {
    img: `people__expert_img017.jpg`,
    position: `執行役員 ｜x-AI事業部長`,
    name: `本田 佳久`,
    introduction: `東京工業大学大学院総合理工学研究科卒業後、日本電気株式会社に入社し、IoT・AI等を活用した新規事業開発に従事。大手小売へ出向し、企業間データ利活用サービス開発を経験。新規事業開発に強みをもつコンサルティングファームに転職し、新規事業開発支援を担当。Relic参画後は、AI/LLMを活用した業務効率化やAIエージェントの企画など、AI/LLM技術の新規事業活用プロジェクトを推進。事業会社・コンサルティングファーム双方での事業開発経験と豊富なプロジェクトマネジメントを強みに、アイデア創出から計画立案、プロトタイプ構築、KPI設定まで一気通貫で支援。`,
  },
  {
    img: `people__expert_img018.jpg`,
    position: `執行役員CIO`,
    name: `佐々木 淳一`,
    introduction: `芝浦工業大学卒業後、大手SIerにて金融系業務システムの開発・インフラ構築を経験。その後、シーエー・モバイル、DMM.comラボでWebシステム開発やプロジェクト進行／チームビルディングを主導。ソフトウェアに加え、ハードウェア開発や電子工作にも精通し、Maker Faire Tokyo等にも参加。2016年4月より、株式会社Relicに参画し、チーフエンジニアとして大企業の新規事業におけるサービスの企画・設計・開発から保守運用、共同事業開発まで幅広く主導。情報システム部門を発足・統括し、「ENjiNE」などのリードエンジニアとして開発・運用を牽引。情報処理安全確保支援士。`,
  },
];
---

<section id="people" class="people main_sec">
  <div class="people__bg"></div>
  <div class="people__inner">
    <div class="contents_wrapper">
      <SectionHeader headingText="私たちを構成する人" imgSrc="text/people__heading.svg" imgWidth={258} imgAlt="PEOPLE" align="left" />
      <h3 class="people__tit">
        <Img
          sources={[
            {
              media: "(max-width: 768px)",
              src: "text/people__tit-sp.svg",
            },
          ]}
          img={{ src: "text/people__tit.svg" }}
          width={570}
          alt="難所を共に越える、多種多様な`事業を立てた経験`を持つ人"
        />
      </h3>
      <p class="people__text">
        メソッドでもプロダクトでもなく、まず「人」。<br class="sp_only" />ご支援に入るのは、自分自身で事業を立ち上げてきた経験を持つ専門人材です。
      </p>
      <div class="people__experts_wrapper swiper js-expert_swiper">
        <p class="people__experts_hint">スワイプで他のメンバーを見る</p>
        <ul class="people__experts swiper-wrapper">
          {
            experts.map((expert) => (
              <li class="people__expert swiper-slide">
                <div class="people__expert_img_block">
                  <Img
                    img={{
                      src: expert.img,
                      widths: [960, 640, 480, 400, 320],
                    }}
                    sizes="(max-width: 768px) 100vw, 400px"
                    width={400}
                    alt={expert.name}
                  />
                </div>
                <p class="people__expert_position" set:html={expert.position} />
                <h4 class="people__expert_name" set:html={expert.name} />
                <p class="people__expert_introduction" set:html={expert.introduction} />
              </li>
            ))
          }
        </ul>
        <div class="swiper-scrollbar"></div>
      </div>
      <div class="people__block01">
        <h4 class="people__block01_tit">
          構想を実行へ変える、<br />Relicの実行体制
        </h4>
        <p class="people__block01_text">
          戦略設計からユーザー検証・開発までを一気通貫で支援する実行体制を構築しています。<br />ビジネスとプロダクトの両視点を持つチームが、事業の成功確度を軸に意思決定を行いながら推進します。
        </p>
        <div class="people__block01_figure">
          <Img
            sources={[
              {
                media: "(max-width: 768px)",
                src: "people__figure-sp.png",
                width: 375,
                widths: [1125, 750, 375],
                sizes: "100vw",
              },
            ]}
            img={{
              src: "people__figure.png",
              widths: [1200, 1000, 800],
            }}
            width={800}
            sizes="(min-width: 1500px) 1800px, 800px"
            alt=""
          />
        </div>
        <div class="people__block01_figure_detail sp_only">
          <Img
            img={{
              src: "people__figure_detail-sp.png",
              widths: [800, 500],
            }}
            sizes="(max-width: 768px) 100vw, 500px"
            width={500}
            alt=""
          />
        </div>
      </div>
      <div class="people__block02_wrapper swiper js-products_swiper">
        <div class="people__block02 swiper-wrapper">
          <div class="people__block02_box swiper-slide">
            <div class="people__block02_box_illust_block">
              <Img
                img={{
                  src: "people__illust01.png",
                  widths: [600, 450, 300],
                }}
                sizes="(max-width: 768px) 100vw, 300px"
                width={300}
                alt=""
              />
            </div>
            <p class="people__block02_box_sub">特徴</p>
            <h4 class="people__block02_box_tit">
              事業を立ち上げた<br />当事者経験を持つ
            </h4>
            <p class="people__block02_box_text">
              自分自身で事業を立ち上げ、グロースさせ、時に撤退判断まで担ってきた人材が、御社の事業オーナーの傍らに座ります。机上の空論ではなく、自分の事業として動かせる人材構成です。
            </p>
          </div>
