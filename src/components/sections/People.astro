<script>
  // @ts-ignore
  import Swiper, { Navigation, Autoplay, EffectFade, Scrollbar } from "swiper";
  // @ts-ignore
  import "swiper/css/bundle";

  // モジュール化を解除し、対象のクラス（.js-expert_swiper）を直接指定
  const sliders = document.querySelectorAll(".js-expert_swiper");

  if (sliders.length > 0) {
    sliders.forEach((slider) => {
      // スクロールバー要素を取得
      const scrollbarEl = slider.querySelector(".swiper-scrollbar");

      new Swiper(slider, {
        // modulesにScrollbarを追加
        modules: [Navigation, Autoplay, EffectFade, Scrollbar],
        mousewheel: false,
        autoHeight: false,
        loop: false,
        slidesPerView: 1.1,
        speed: 500,
        spaceBetween: "5%",

        // スクロールバーの設定を追加
        scrollbar: scrollbarEl
          ? {
              el: scrollbarEl,
              draggable: true, // ドラッグ操作を有効化
            }
          : false,

        breakpoints: {
          768: {
            slidesPerView: 3.5,
            spaceBetween: "3.25%",
          },
        },
      });
    });
  }
</script>
