---
import Img from "../utils/ImgLoader.astro";
---

<section class="benefit main_sec">
  <div class="contents_wrapper">
    <h2 class="benefit__heading">私たちの提供価値</h2>
    <h3 class="benefit__tit">
      <Img
        sources={[
          {
            media: "(max-width: 768px)",
            src: "text/benefit__tit-sp.svg",
            width: 332,
          },
        ]}
        img={{ src: "text/benefit__tit.svg" }}
        width={640}
        alt="新規事業開発における難所の理解を持ち、それを共に乗り越え、新規事業を、確実に「形」にする。"
      />
    </h3>
    <p class="benefit__name">事業共創カンパニー Relic</p>
  </div>
</section>

<style lang="scss">
  .benefit {
    position: relative;
    padding: 14rem 0 16rem;
    background: var(--color-gray01);
    background-image: url(/src/assets/img/design/benefit__bg.jpg);
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center center;
    color: var(--color-white);
    border-bottom: 1rem solid var(--color-black02);
    border-image: linear-gradient(
      90deg,
      rgba(20, 60, 93, 1) 0%,
      rgba(22, 59, 93, 1) 17%,
      rgba(29, 57, 94, 1) 24%,
      rgba(41, 53, 96, 1) 29%,
      rgba(59, 48, 98, 1) 34%,
      rgba(82, 41, 101, 1) 38%,
      rgba(110, 33, 105, 1) 41%,
      rgba(144, 23, 110, 1) 44%,
      rgba(182, 13, 115, 1) 47%,
      rgba(227, 2, 122, 1) 50%,
      rgba(224, 40, 122, 1) 53%,
      rgba(222, 73, 122, 1) 56%,
      rgba(219, 101, 122, 1) 60%,
      rgba(218, 124, 122, 1) 64%,
      rgba(216, 142, 122, 1) 69%,
      rgba(215, 154, 122, 1) 75%,
      rgba(215, 161, 122, 1) 82%,
      rgba(215, 164, 122, 1) 100%
    );
    border-image-slice: 1;
    @include media_max(sp) {
      padding: 7.6rem 0 8.2rem;
      background-image: url(/src/assets/img/design/benefit__bg-sp.jpg);
    }

    &__heading {
      position: relative;
      width: fit-content;
      padding: 0 0.1em 1.4em;
      margin: 0 auto 6rem;
      color: var(--color-white);
      font-size: 18px;
      line-height: 1.1;
      @include media_max(sp) {
        font-size: 1.7rem;
        margin-bottom: 3.5rem;
        padding-bottom: 1.2em;
      }

      &::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%) translateY(100%);
        width: calc(100% - 0.4em);
        height: 0.4rem;
        background: var(--color-white);
        @include media_max(sp) {
          width: calc(100% - 0.8em);
          height: 0.3rem;
        }
      }
    }

    &__tit :global(img) {
      width: auto;
      height: 14.4rem;
      max-width: 100%;
      margin: 0 auto;
      object-fit: contain;
      @include media_max(sp) {
        width: 96.9%;
        height: auto;
      }
    }

    &__name {
      display: flex;
      align-items: center;
      justify-content: center;
      column-gap: 1rem;
      margin: 5.4rem auto 0;
      font-size: 1.4rem;
      font-weight: 700;
      line-height: 1.2;
      text-align: center;
      letter-spacing: 0.25em;
      @include media_max(sp) {
        margin-top: 2.9rem;
        font-size: 1.3rem;
        letter-spacing: 0.2em;
      }

      &::before {
        content: "";
        position: relative;
        top: 2px;
        display: inline-block;
        width: 5.4rem;
        height: 1px;
        background: var(--color-white);
        @include media_max(sp) {
          width: 5rem;
        }
      }
    }
  }
</style>
