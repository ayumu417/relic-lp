<style lang="scss">
  .resouce {
    position: relative;
    background: transparent;
    padding-top: 7.6rem;
    padding-bottom: 19rem;
    @include media_max(sp) {
      padding-top: 12rem;
      padding-bottom: 11.7rem;
    }

    &::before {
      content: "";
      position: absolute;
      top: 1rem;
      right: 0;
      background-image: var(--bgVisualImgUrl);
      background-repeat: no-repeat;
      background-size: cover;
      width: clamp(59rem, 41vw, 70rem);
      height: auto;
      aspect-ratio: 590/210;
      @include media_max(sp) {
        top: -5rem;
        width: 32rem;
        aspect-ratio: 590/190;
      }
    }

    &::after {
      content: "";
      position: absolute;
      bottom: -59.6rem;
      left: 0;
      background-image: var(--bgDesignImgUrl);
      background-repeat: no-repeat;
      background-size: cover;
      width: 45rem;
      height: auto;
      aspect-ratio: 449/1461;
      z-index: -1;
      @include media_max(sp) {
        bottom: -31.5rem;
        background-image: var(--bgDesignImgSpUrl);
        width: 14rem;
        aspect-ratio: 135/439;
      }
    }

    &__bg::after {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: #f1f1f1;
      z-index: -1;
      @include media_max(sp) {
        height: calc(100%);
        background-image: linear-gradient(#f3fbfc 1px, transparent 1px), linear-gradient(90deg, #f3fbfc 1px, transparent 1px);
        background-size: 6.2rem 6.2rem;
        background-position: 0rem 0rem;
      }
    }

    &__tit :global(img) {
      width: auto;
      height: 10.8rem;
      max-width: 100%;
      margin: 0;
      object-fit: contain;
      @include media_max(sp) {
        height: 6.2rem;
      }
    }

    &__text {
      font-weight: 500;
      margin-top: 3.2rem;
      @include media_max(sp) {
        margin-top: 2rem;
      }
    }

    &__button {
      margin-top: 6.2rem;
      @include media_max(sp) {
        margin-top: 4.7rem;
      }
    }

    //　sp版はswiper
    &__list_wrapper {
      @include media_min(sp) {
        overflow: inherit;
      }
      @include media_max(sp) {
        margin-left: -2.5rem;
        margin-right: -2.5rem;
      }
    }
    & &__list {
      @include media_min(sp) {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        align-items: stretch;
        column-gap: 2.2rem;
        row-gap: 2.4rem;
        margin-top: 5.5rem;
      }
      @include media_max(sp) {
        margin-top: 2.5rem;
      }
      &_item {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 100%;
        border-radius: 1.4rem;
        padding-top: 2.4rem;
        overflow: hidden;
        background: var(--color-white);
        box-shadow: 0 0 2rem rgba(0, 0, 0, 0.1);
        @include media_max(sp) {
          padding-top: 2rem;
        }

        &_img_block {
          :global(img) {
            width: 100%;
          }
        }

        &_contents {
          flex: 1;
          width: 100%;
          height: auto;
          display: flex;
          flex-direction: column;
          justify-content: space-between;
          align-items: flex-start;
          padding: 2rem 3.2rem 4rem;
          @include media_max(sp) {
            padding: 2rem 2.5rem 3.2rem;
          }
        }

        &_tags {
          display: flex;
          align-items: stretch;
          justify-content: flex-start;
          flex-wrap: wrap;
          column-gap: 0.5rem;
          margin: 0 0 1.4rem;
        }
        &_tag {
          display: flex;
          align-items: center;
          justify-content: center;
          height: auto;
          padding: 0.3em 0.92em 0.35em;
          background: #fff;
          color: var(--color-black01);
          font-size: 1.3rem;
          font-weight: 700;
          line-height: 1.2;
          letter-spacing: 0.05em;

          &[data-color="white"] {
            background: #fff;
            color: var(--color-black01);
            border: 1px solid var(--color-black01);
          }
          &[data-color="black"] {
            background: var(--color-black01);
            color: var(--color-white);
          }
          &[data-color="magenta"] {
            background: var(--color-magenta01);
            color: var(--color-white);
          }
          &[data-color="pale_blue"] {
            background: #5181c5;
            color: var(--color-white);
          }
          &[data-color="gold"] {
            background: #c8aa66;
            color: var(--color-white);
          }
          &[data-color="light_green"] {
            background: #5fae9c;
            color: var(--color-white);
          }
          &[data-color="pale_red"] {
            background: #ca6060;
            color: var(--color-white);
          }
        }

        &_tit {
          color: var(--color-black01);
          font-size: 1.7rem;
          font-weight: 700;
          font-family: var(--font-noto_serif);
          line-height: 1.45;
          letter-spacing: -0.01em;
        }

        &_detail {
          color: var(--color-black01);
          margin-top: 0.9rem;
          font-size: 1.5rem;
          font-weight: 700;
          font-family: var(--font-noto_serif);
          line-height: 1.5;
        }

        &_meta {
          margin-top: 1rem;
          font-size: 1.4rem;
          line-height: 1.2;
        }

        &_button {
          margin-top: 2.1rem;
          width: 90.4%;
        }
      }
    }

    // swiepr初期化時の調整
    @include media_max(sp) {
      &__list_wrapper:not(.swiper-initialized) {
        opacity: 0;
      }
      &__list_wrapper:not(.swiper-initialized) .resouce__list_item:not(:first-of-type) {
        display: none;
      }
    }

    :global(.cta) {
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%) translateY(50%);
    }
  }
</style>

<script>
  import { setupResponsiveSwiperSp } from "../../assets/js/setupSwiperSp"; // 拡張子は環境に合わせて調整

  // このセクションのクラス名を指定して実行
  setupResponsiveSwiperSp(".js-resouce_swiper");
</script>
