            />
          </div>
          <div class="resouce__list_item_contents">
            <div class="resouce__list_item_contents_inner">
              <div class="resouce__list_item_tags">
                <p class="resouce__list_item_tag" data-color="magenta">新着</p>
                <p class="resouce__list_item_tag" data-color="black">テーマ別</p>
                <p class="resouce__list_item_tag" data-color="white">最重要</p>
              </div>
              <h4 class="resouce__list_item_tit">
                大企業のための<br />
                「出島スキーム」完全ガイド
              </h4>
              <p class="resouce__list_item_detail">制約を越えて事業を形にする実務</p>
              <p class="resouce__list_item_meta">全48P／2026年最新版</p>
            </div>
            <Button class="resouce__list_item_button" href="https://relic.co.jp/webinar/20250805_ip_03/" target="_blank" rel="noopener noreferrer" color="beige"> 資料をダウンロード </Button>
