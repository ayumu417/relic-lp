---
import Img from "../utils/ImgLoader.astro";
import Button from "../ui/Button.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import Cta from "../block/Cta.astro";

/***   背景画像   ***/
import { getImage } from "astro:assets";
import bgVisualImg from "../../assets/img/design/bg_visual_img03.jpg";
import bgDesignImg from "../../assets/img/design/bg_design_img06.png";
import bgDesignImgSp from "../../assets/img/design/bg_design_img06-sp.png";

const bgVisualImgOptimized = await getImage({ src: bgVisualImg, format: "webp" });
const bgDesignImgOptimized = await getImage({ src: bgDesignImg, format: "webp" });
const bgDesignImgSpOptimized = await getImage({ src: bgDesignImgSp, format: "webp" });
---

<section
  class="resouce main_section"
  style={{
    "--bgVisualImgUrl": `url(${bgVisualImgOptimized.src})`,
    "--bgDesignImgUrl": `url(${bgDesignImgOptimized.src})`,
    "--bgDesignImgSpUrl": `url(${bgDesignImgSpOptimized.src})`,
  }}
