---
import Img from "../utils/ImgLoader.astro";
import Button from "../ui/Button.astro";
import SectionHeader from "../ui/SectionHeader.astro";

/**
 * 「オンライン講演動画」の型定義
 */
type Video = {
  date: string;
  number: string;
  tag: string;
  tit: string;
  speaker: string;
  time: string;
  type: string;
  link: string;
};

/**
 * 「オンライン講演動画」を配列で管理
 * ※ HTMLタグの記載可能
 */
const videos: Video[] = [
  {
    date: `2026年4月`,
    number: `第32回`,
    tag: `出島スキーム`,
    tit: `新規事業を「形にする」──出島スキーム実践事例`,
    speaker: `登壇：Relic 事業プロデュース統括／大手製造業 新規事業推進室 室長`,
    time: `視聴目安 60分`,
    type: `申込 412名／業界横断`,
    link: `#`,
  },
  {
    date: `2026年3月`,
    number: `第31回`,
    tag: `業界別／金融`,
    tit: `大手金融機関の新規事業──BaaS／組込み型金融の事業化最前線`,
    speaker: `登壇：Relic CVC 担当ディレクター／金融大手 DX推進部 部長`,
    time: `視聴目安 75分`,
    type: `申込 368名／金融機関中心`,
    link: `#`,
  },
  {
    date: `2026年2月`,
    number: `第30回`,
    tag: `技術活用`,
    tit: `生成AI／LLM時代の新規事業創出──PoCから事業化までのリアルな道のり`,
    speaker: `登壇：Relic CTO／AWS高度パートナー認定エンジニア`,
    time: `視聴目安 65分`,
    type: `申込 524名／DX推進部門中心`,
    link: `#`,
  },
  {
    date: `2026年1月`,
    number: `第29回`,
    tag: `人材・組織`,
    tit: `社内起業家を発掘・育成する制度設計──Innovator's 101の現場から`,
    speaker: `登壇：Relic 人材育成事業責任者`,
    time: `視聴目安 60分`,
    type: `申込 295名／人事・新規事業`,
    link: `#`,
  },
];
---

<section class="videos main_section lazy_section">
  <div class="contents_wrapper">
    <SectionHeader
      headingText="講演動画"
      imgSrc="text/videos__heading.svg"
      imgWidth={180}
      imgAlt="VIDEOS"
      align="center"
    />

    <h3 class="videos__tit">
      <Img
        img={{ src: "text/videos__tit.svg" }}
        width={340}
        alt="オンライン講演動画"
      />
    </h3>

    <p class="videos__text">
      新規事業推進者向けに毎月開催しているオンライン講演の動画一覧。<br
        class="pc_only"
      />登壇者は事業を実際に立ち上げてきた専門人材と、ご一緒した企業のご担当者さまです。
    </p>

    <ul class="videos__list">
      {
        videos.map((video) => (
          <li class="videos__list_item">
            <div class="videos__list_item_detail01">
              <p class="videos__list_item_date" set:html={video.date} />
              <p class="videos__list_item_number" set:html={video.number} />
            </div>
            <div class="videos__list_item_tags">
              <p class="videos__list_item_tag" set:html={video.tag} />
            </div>
            <div class="videos__list_item_detail02">
              <h4 class="videos__list_item_tit" set:html={video.tit} />
              <p class="videos__list_item_speaker" set:html={video.speaker} />
            </div>
            <div class="videos__list_item_detail03">
              <p class="videos__list_item_time" set:html={video.time} />
              <p class="videos__list_item_type" set:html={video.type} />
            </div>
            <div class="videos__list_item_button_wrapper">
              <Button
                class="videos__list_item_button"
                href={video.link}
                target="_blank"
                rel="noopener noreferrer"
                color="beige"
              >
                視聴する
              </Button>
            </div>
          </li>
        ))
      }
    </ul>

    <Button
      class="videos__button"
      href="#"
      target="_blank"
      rel="noopener noreferrer"
    >
      講演動画をすべて見る
    </Button>
  </div>
</section>

<style lang="scss">
  /* CSS部分は変更なしのため省略せずにそのままお使いいただけます */
  .videos {
    position: relative;
    padding-bottom: 0;
    margin-bottom: 13rem;
    @include media_min(sp) {
      padding-top: 19rem;
    }
    @include media_max(sp) {
      padding-top: 12.5rem;
      margin-bottom: 7rem;
    }

    .contents_wrapper {
      max-width: var(--wrapper-s);
    }

    @include media_max(sp) {
      :global(.section_header) {
        align-items: flex-end;
      }
    }

    &__tit :global(img) {
      width: auto;
      height: 4rem;
      max-width: 100%;
      margin: 0 auto;
      object-fit: contain;
      @include media_max(sp) {
        height: 2.8rem;
        margin-right: 0;
      }
    }

    &__text {
      margin-top: 2.2em;
      text-align: center;
      font-size: 1em;
      font-weight: 500;
      @include media_max(sp) {
        margin-top: 2.5rem;
        text-align: left;
        font-size: 1.47rem;
        letter-spacing: -0.03em;
      }
    }

    &__button {
      margin-top: 6.6rem;
      @include media_max(sp) {
        margin-top: 3.2rem;
      }
    }

    &__list {
      border-top: 1px solid var(--color-black01);
      margin: 6rem 0 0;
      @include media_max(sp) {
        margin-top: 3rem;
      }

      &_item {
        display: grid;
        grid-template-columns: 9.2rem auto 19rem 15rem;
        column-gap: 1.1rem;
        align-items: center;
        padding: 2.5rem 0 2.6rem 0.5rem;
        border-bottom: 1px solid var(--color-black01);
        @include media_max(sp) {
          grid-template-columns: auto 1fr 16.2rem;
          column-gap: 0;
          padding: 1.6rem 0 1.7rem;
        }

        &_detail01 {
          grid-column: 1/2;
          grid-row: 1/3;
          @include media_max(sp) {
            grid-column: 1/2;
            grid-row: 1/2;
            display: flex;
            align-items: center;
            justify-content: flex-start;
            column-gap: 1rem;
            margin-right: 1.2rem;
          }
        }
        &_tags {
          grid-column: 2/3;
          grid-row: 1/2;
          display: flex;
          align-items: flex-start;
          justify-content: flex-start;
          margin: 0 0 0.9rem;
          @include media_max(sp) {
            grid-column: 2/4;
            grid-row: 1/2;
            margin-bottom: 0;
          }
        }
        &_detail02 {
          grid-column: 2/3;
          grid-row: 2/3;
          @include media_max(sp) {
            grid-column: 1/4;
            grid-row: 2/3;
            margin-top: 0.9rem;
            margin-bottom: 1rem;
          }
        }
        &_detail03 {
          grid-column: 3/4;
          grid-row: 1/3;
          @include media_max(sp) {
            grid-column: 1/3;
            grid-row: 3/4;
          }
        }
        &_button_wrapper {
          grid-column: 4/5;
          grid-row: 1/3;
          @include media_max(sp) {
            grid-column: 3/4;
            grid-row: 3/4;
          }
        }

        &_tag {
          width: fit-content;
          padding: 0.2em 0.86em 0.25em;
          background: var(--color-black02);
          color: var(--color-white);
          font-size: 1.3rem;
          font-weight: 700;
          line-height: 1.4;
          letter-spacing: 0.05em;
        }
        &_date {
          margin-bottom: 0.4rem;
          font-size: 1.2rem;
          font-weight: 500;
          letter-spacing: 0.05em;
          line-height: 1.4;
          @include media_max(sp) {
            margin-bottom: 0;
          }
        }
        &_number {
          color: var(--color-gray01);
          font-size: 1.5rem;
          font-weight: 500;
          line-height: 1.4;
          @include media_max(sp) {
          }
        }
        &_tit {
          color: var(--color-black01);
          margin-bottom: 0.5rem;
          font-size: 1.5rem;
          font-family: var(--font-noto_serif);
          font-weight: 700;
          line-height: 1.5;
          @include media_max(sp) {
            letter-spacing: -0.025em;
            margin-bottom: 0.7rem;
          }
        }
        &_speaker {
          font-size: 1.3rem;
          color: var(--color-gray01);
          line-height: 1.3;
          @include media_max(sp) {
          }
        }
        &_time {
          margin-bottom: 1rem;
          font-size: 1.5rem;
          font-weight: 700;
          line-height: 1.5;
          @include media_max(sp) {
            font-size: 1.3rem;
            margin-bottom: 0.2rem;
          }
        }
        &_type {
          font-size: 1.3rem;
          font-weight: 400;
          line-height: 1.3;
          @include media_max(sp) {
          }
        }
        &_button {
          width: 100%;
          min-height: 5.2rem;
          padding-left: 1.4em;
          padding-right: 2em;
          @include media_max(sp) {
            padding-right: 1.4em;
            min-height: 4.8rem;
          }
        }
      }
    }
  }
</style>