---
import Img from "../utils/ImgLoader.astro";
import Button from "../ui/Button.astro";
import SectionHeader from "../ui/SectionHeader.astro";
---

<section class="test main_sec">
  <div class="contents_wrapper">
    <SectionHeader
      headingText=""
      imgSrc="text/test__heading.svg"
      imgWidth={258}
      imgAlt="RESOURCE"
      align="left"
    />

    <h3 class="test__tit">
      <Img img={{ src: "text/test__tit.svg" }} width={570} alt="" />
    </h3>
  </div>
</section>


<style lang="scss">
  .test {
    position: relative;

    &__tit :global(img) {
      width: auto;
      height: 10.8rem;
      max-width: 100%;
      margin: 0;
      object-fit: contain;
      @include media_max(sp) {
        height: 6.2rem;
      }
    }
  }
</style>
