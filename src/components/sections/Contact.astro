---
import Img from "../utils/ImgLoader.astro";
import Button from "../ui/Button.astro";
import SectionHeader from "../ui/SectionHeader.astro";

/***   背景画像   ***/
import { getImage } from "astro:assets";
import contactBgPc from "../../assets/img/design/contact__bg-pc.jpg";
import contactBgSp from "../../assets/img/design/contact__bg-sp.jpg";

// 背景画像の最適化（WebP変換）処理
const contactBgPcOptimized = await getImage({ src: contactBgPc, format: "webp" });
const contactBgSpOptimized = await getImage({ src: contactBgSp, format: "webp" });
---

<!-- お問い合わせ（CONTACT）セクション -->
<section
  class="contact main_section lazy_section"
  style={{
    "--contactBgPcUrl": `url(${contactBgPcOptimized.src})`,
    "--contactBgSpUrl": `url(${contactBgSpOptimized.src})`,
  }}
>
  <div class="contents_wrapper">
    <!-- セクションヘッダー -->
    <SectionHeader headingText="お問い合わせ" imgSrc="text/contact__heading.svg" imgWidth={228} imgAlt="CONTACT" align="center" />

    <!-- メイン見出し画像 -->
    <h3 class="contact__tit">
      <Img img={{ src: "text/contact__tit.svg" }} width={530} alt="お問い合わせはこちらから" />
    </h3>

    <!-- お問い合わせカード一覧（2カラム/SP時1カラム） -->
    <div class="contact__block">
      <!-- カード01：無料相談のお申し込み -->
      <div class="contact__box01" data-item="01">
        <div class="contact__box01_img_block">
          <Img
            img={{
              src: "contact__illust01.png",
              widths: [600, 400, 300],
            }}
            sizes="(max-width: 768px) 90vw, 400px"
            width={400}
            alt=""
          />
        </div>
        <h4 class="contact__box01_tit">無料相談のお申し込み</h4>
        <p class="contact__box01_text">現状の課題と目指したい姿を伺い、出島スキームが使えるかどうかも含めて、進め方をご提案します。</p>
        <div class="contact__box01_block">
          <h4 class="contact__box01_block_tit">当日カバー範囲</h4>
          <p class="contact__box01_block_text">事業構想・フェーズ整理・出島スキームの適用可否・ロードマップ案・予算感のご提示まで</p>
        </div>
        <Button class="contact__box01_button" href="#" target="_blank" rel="noopener noreferrer" color="blue"> 無料相談を申し込む </Button>
      </div>

      <!-- カード02：資料・ホワイトペーパー請求 -->
      <div class="contact__box01" data-item="02">
        <!-- data-shadow="on" で画像にドロップシャドウを適用 -->
        <div class="contact__box01_img_block" data-shadow="on">
          <Img
            img={{
              src: "contact__img01.png",
              widths: [600, 400, 300],
            }}
            sizes="(max-width: 768px) 90vw, 400px"
            width={400}
            alt=""
          />
        </div>
        <h4 class="contact__box01_tit">資料・ホワイトペーパーを請求</h4>
        <p class="contact__box01_text">支援メニュー・自社プロダクト・グループ会社・ご支援実績まで網羅した会社資料に加え、最新ホワイトペーパーを同時お届け。</p>
        <div class="contact__box01_block">
          <h4 class="contact__box01_block_tit">同梱コンテンツ</h4>
          <p class="contact__box01_block_text">ホワイトペーパー『大企業のための「出島スキーム」完全ガイド』を同梱</p>
        </div>
        <Button class="contact__box01_button" href="https://relic.co.jp/contact_dl/" target="_blank" color="beige"> 資料・ホワイトペーパーを請求する </Button>
      </div>

      <!-- カード03：メールマガジン登録（PC時は全幅表示） -->
      <div class="contact__box02" data-item="03">
        <div class="contact__box02_contents">
          <h4 class="contact__box02_tit">メールマガジンに登録する</h4>
          <p class="contact__box02_text">
            最新ホワイトペーパー・限定オンライン講演・事業創出事例を、月数回お届け。<br />
            情報収集段階のご登録も歓迎です。
          </p>
          <dl>
            <dt>配信内容</dt>
            <dd>新規事業ホワイトペーパー／実践オンライン講演／導入事例ストーリー</dd>
          </dl>
        </div>

        <Button class="contact__box02_button" href="https://share.hsforms.com/1nw9RDNx8Sxa-BEIMJuYdogqbc34" target="_blank" rel="noopener noreferrer" color="white"> メールマガジンに登録する </Button>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  /* お問い合わせセクション全体のスタイル */
  .contact {
    position: relative;
    background: var(--color-black02);
    background-repeat: no-repeat;
    background-size: cover;
    
    /* PC/SPでの背景画像切り替え */
    @include media_min(sp) {
      background-image: var(--contactBgPcUrl);
      padding-top: 14rem;
      padding-bottom: 20rem;
    }
    @include media_max(sp) {
      background-image: var(--contactBgSpUrl);
    }

    .contents_wrapper {
      max-width: 104rem;
    }

    /* セクションヘッダーのアンダーライン色などを上書き */
    :global(.section_header) {
      color: var(--color-white);
      &::after {
        background: #e3027a;
      }
    }

    /* 見出し画像スタイル */
    &__tit :global(img) {
      width: auto;
      height: 4.55rem;
      max-width: 100%;
      margin: 0 auto;
      object-fit: contain;
      @include media_max(sp) {
        height: 2.6rem;
      }
    }

    /* お問い合わせカード配置用グリッドレイアウト */
    &__block {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: 4rem;
      row-gap: 4.1rem;
      margin-top: 6.2rem;
      @include media_max(sp) {
        display: flex;
        flex-direction: column;
        row-gap: 1.2rem;
        margin-top: 2.6rem;
      }
    }

    /* 白色カード（無料相談・資料請求）のスタイル */
    &__box01 {
      position: relative;
      width: 100%;
      padding: 5rem 5.4rem 6rem;
      background: var(--color-white);
      border-radius: 1.4rem;
      @include media_max(sp) {
        padding: 2.5rem 2.5rem 3.2rem;
      }

      /* カード内画像ブロック */
      &_img_block {
        margin: 0 auto 1.8rem;
        /* data-shadow="on"属性が付与されている場合の影指定 */
        &[data-shadow="on"] {
          filter: drop-shadow(0.4rem 0.4rem 0.4rem rgba(0, 0, 0, 0.25));
        }
        @include media_max(sp) {
          margin-bottom: 1.4rem;
        }
      }
      /* アイテム01のみSPでのマージン微調整 */
      &[data-item="01"] &_img_block {
        @include media_max(sp) {
          margin-top: -0.8rem;
          margin-bottom: 0rem;
        }
      }

      &_tit {
        margin: 0 auto 1.4rem;
        text-align: center;
        font-size: 2.8rem;
        font-weight: 700;
        line-height: 1.4;
        @include media_max(sp) {
          margin-bottom: 0.8rem;
          font-size: 2rem;
        }
      }
      &_text {
        min-height: 5.1em;
        margin-bottom: 1.5em;
        font-size: 1.5rem;
        line-height: 1.7;
        @include media_max(sp) {
          min-height: 1em;
          margin-bottom: 1.8rem;
          font-size: 1.4rem;
        }
      }
      /* カバー範囲・同梱コンテンツ枠 */
      &_block {
        border-top: 1px solid var(--color-black01);
        padding-top: 1.7rem;
        @include media_max(sp) {
          padding-top: 1.4rem;
        }

        &_tit {
          margin: 0 0 0.4rem;
          font-size: 1.5rem;
          line-height: 1.7;
          @include media_max(sp) {
            font-size: 1.4rem;
          }
        }
        &_text {
          color: var(--color-gray01);
          font-size: 1.44rem;
          line-height: 1.6;
          @include media_max(sp) {
            font-size: 1.4rem;
          }
        }
      }

      &_button {
        margin-top: 3.5rem;
        min-height: 6rem;
        @include media_max(sp) {
          margin-top: 1.7rem;
          min-height: 4.8rem;
        }
      }
    }

    /* 枠線のみのワイドカード（メルマガ登録）のスタイル */
    &__box02 {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      column-gap: 3.5rem;
      background: transparent;
      padding: 3.1rem 5rem 3.4rem 4rem;
      border: 2px solid var(--color-white);
      border-radius: 1.4rem;
      color: var(--color-white);
      /* PC時は2カラム分の横幅を占有 */
      @include media_min(sp) {
        grid-column: 1/3;
      }
      @include media_max(sp) {
        display: block;
        padding: 3.4rem 2.5rem;
        background: #787878;
      }

      &_tit {
        margin: 0 0 0.8rem;
        font-size: 2.6rem;
        line-height: 1.4;
        @include media_max(sp) {
          margin-bottom: 1rem;
          font-size: 2rem;
          text-align: center;
        }
      }

      &_text {
        font-size: 1.4rem;
        font-weight: 400;
        line-height: 1.8;
        @include media_max(sp) {
          line-height: 1.6;
        }
      }

      /* 配信内容リスト */
      dl {
        display: flex;
        align-items: flex-start;
        justify-content: flex-start;
        column-gap: 2.5rem;
        border-top: 1px solid var(--color-white);
        padding-top: 1.8rem;
        margin-top: 1.6rem;
        @include media_max(sp) {
          display: block;
          padding-top: 1.2rem;
        }
      }
      dt {
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1.6;
        @include media_max(sp) {
          margin-bottom: 0.62rem;
          font-size: 1.4rem;
        }
      }
      dd {
        flex: 1;
        text-align: left;
        font-size: 1.4rem;
        line-height: 1.6;
      }

      /* 変数オーバーライド */
      &_button {
        --bg_color: var(--color-white);
        --text_color: var(--color-black02);
        --border_color: var(--color-white);
        @include media_max(sp) {
          margin-top: 1.8rem;
        }
      }
    }
  }
</style>
