---
import Img from "../utils/ImgLoader.astro";
import Button from "../ui/Button.astro";
import SectionHeader from "../ui/SectionHeader.astro";
---

<section class="contact main">
  <div class="contents_wrapper">
    <SectionHeader
      headingText="お問い合わせ"
      imgSrc="text/contact__heading.svg"
      imgWidth={228}
      imgAlt="CONTACT"
      align="center"
    />

    <p class="contact__emphasized_text">
      <Img
        img={{ src: "text/contact__emphasized_text.svg" }}
        width={530}
        alt="お問い合わせはこちらから"
      />
    </p>

    <div class="contact__block">
      <div class="contact__box01" data-item="01">
        <div class="contact__box01_img_block">
          <Img
            img={{
              src: "contact__illust01.png",
              widths: [600, 400, 300],
            }}
            sizes="(max-width: 768px) 100vw, 400px"
            width={400}
            alt=""
          />
        </div>
        <h3 class="contact__box01_tit">無料相談のお申し込み</h3>
        <p class="contact__box01_text">
          現状の課題と目指したい姿を伺い、出島スキームが使えるかどうかも含めて、進め方をご提案します。
        </p>
        <div class="contact__box01_block">
          <h4 class="contact__box01_block_tit">当日カバー範囲</h4>
          <p class="contact__box01_block_text">
            事業構想・フェーズ整理・出島スキームの適用可否・ロードマップ案・予算感のご提示まで
          </p>
        </div>
        <Button
          text="無料相談を申し込む"
          class="contact__box01_btn"
          href="###"
          target="_blank"
          rel="noopener noreferrer"
          data-color="blue"
        />
      </div>
      <div class="contact__box01" data-item="02">
        <div class="contact__box01_img_block" data-shadow="on">
          <Img
            img={{
              src: "contact__img01.png",
              widths: [600, 400, 300],
            }}
            sizes="(max-width: 768px) 100vw, 400px"
            width={400}
            alt=""
          />
        </div>
        <h3 class="contact__box01_tit">資料・ホワイトペーパーを請求</h3>
        <p class="contact__box01_text">
          支援メニュー・自社プロダクト・グループ会社・ご支援実績まで網羅した会社資料に加え、最新ホワイトペーパーを同時お届け。
        </p>
        <div class="contact__box01_block">
          <h4 class="contact__box01_block_tit">同梱コンテンツ</h4>
          <p class="contact__box01_block_text">
            ホワイトペーパー『大企業のための「出島スキーム」完全ガイド』を同梱
          </p>
        </div>
        <Button
          text="資料・ホワイトペーパーを請求する"
          class="contact__box01_btn"
          href="###"
          target="_blank"
          rel="noopener noreferrer"
          data-color="beige"
        />
      </div>
      <div class="contact__box02" data-item="03">
        <div class="contact__box02_contents">
          <h3 class="contact__box02_tit">メールマガジンに登録する</h3>
          <p class="contact__box02_text">
            最新ホワイトペーパー・限定オンライン講演・事業創出事例を、月数回お届け。<br
            />
            情報収集段階のご登録も歓迎です。
          </p>
          <dl>
            <dt>配信内容</dt>
            <dd>
              新規事業ホワイトペーパー／実践オンライン講演／導入事例ストーリー
            </dd>
          </dl>
        </div>

        <Button
          text="メールマガジンに登録する"
          class="contact__box02_button"
          href="###"
          target="_blank"
          rel="noopener noreferrer"
        />
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .contact {
    position: relative;
    background: var(--color-black02);
    background-repeat: no-repeat;
    background-size: cover;
    @include media_min(sp) {
      background-image: url(../../assets/img/design/contact__bg-pc.jpg);
      padding-top: 14rem;
      padding-bottom: 20rem;
    }
    @include media_max(sp) {
      background-image: url(../../assets/img/design/contact__bg-sp.jpg);
    }

    .contents_wrapper {
      max-width: 104rem;
    }

    :global(.section_header) {
      color: var(--color-white);
      &::after {
        background: #e3027a;
      }
    }

    &__emphasized_text :global(img) {
      width: auto;
      height: 4.55rem;
      max-width: 100%;
      margin: 0 auto;
      object-fit: contain;
      @include media_max(sp) {
        height: 2.6rem;
      }
    }

    &__block {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: 4rem;
      row-gap: 4.1rem;
      margin-top: 6.2rem;
      @include media_max(sp) {
        display: flex;
        flex-direction: column;
        row-gap: 1.2rem;
        margin-top: 2.6rem;
      }
    }

    /* box 01 */
    &__box01 {
      position: relative;
      width: 100%;
      padding: 5rem 5.4rem 6rem;
      background: var(--color-white);
      border-radius: 1.4rem;
      @include media_max(sp) {
        padding: 2.5rem 2.5rem 3.2rem;
      }

      &_img_block {
        margin: 0 auto 1.8rem;
        &[data-shadow="on"] {
          filter: drop-shadow(0.4rem 0.4rem 0.4rem rgba(0, 0, 0, 0.25));
        }
        @include media_max(sp) {
          margin-bottom: 1.4rem;
        }
      }
      &[data-item="01"] &_img_block {
        @include media_max(sp) {
          margin-top: -0.8rem;
          margin-bottom: 0rem;
        }
      }

      &_tit {
        margin: 0 auto 1.4rem;
        text-align: center;
        font-size: 2.8rem;
        font-weight: 700;
        line-height: 1.4;
        @include media_max(sp) {
          margin-bottom: 0.8rem;
          font-size: 2rem;
        }
      }
      &_text {
        min-height: 5.1em;
        margin-bottom: 1.5em;
        font-size: 1.5rem;
        line-height: 1.7;
        @include media_max(sp) {
          min-height: 1em;
          margin-bottom: 1.8rem;
          font-size: 1.4rem;
        }
      }
      &_block {
        border-top: 1px solid var(--color-black01);
        padding-top: 1.7rem;
        @include media_max(sp) {
          padding-top: 1.4rem;
        }

        &_tit {
          margin: 0 0 0.4rem;
          font-size: 1.5rem;
          line-height: 1.7;
          @include media_max(sp) {
            font-size: 1.4rem;
          }
        }
        &_text {
          color: var(--color-gray01);
          font-size: 1.44rem;
          line-height: 1.6;
          @include media_max(sp) {
            font-size: 1.4rem;
          }
        }
      }

      &_btn {
        margin-top: 3.5rem;
        min-height: 6rem;
        @include media_max(sp) {
          margin-top: 1.7rem;
          min-height: 4.8rem;
        }

        &[data-color="blue"] {
          --bg_color: var(--color-deep_blue01);
          --text_color: var(--color-white);
          --border_color: var(--color-deep_blue01);
        }
        &[data-color="beige"] {
          --bg_color: var(--color-dark_beige01);
          --text_color: var(--color-black02);
          --border_color: var(--color-dark_beige01);

          &:hover {
            --bg_color: var(--color-dark_beige01);
            --text_color: var(--color-white);
            --border_color: var(--color-dark_beige01);
            background: var(--text_color);
            filter: brightness(1);
          }
        }
      }
    }

    /* box 02 */
    &__box02 {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      column-gap: 3.5rem;
      background: transparent;
      padding: 3.1rem 5rem 3.4rem 4rem;
      border: 2px solid var(--color-white);
      border-radius: 1.4rem;
      color: var(--color-white);
      @include media_min(sp) {
        grid-column: 1/3;
      }
      @include media_max(sp) {
        display: block;
        padding: 3.4rem 2.5rem;
        background: #787878;
      }

      &_tit {
        margin: 0 0 0.8rem;
        font-size: 2.6rem;
        line-height: 1.4;
        @include media_max(sp) {
          margin-bottom: 1rem;
          font-size: 2rem;
          text-align: center;
        }
      }

      &_text {
        font-size: 1.4rem;
        font-weight: 400;
        line-height: 1.8;
        @include media_max(sp) {
          line-height: 1.6;
        }
      }

      dl {
        display: flex;
        align-items: flex-start;
        justify-content: flex-start;
        column-gap: 2.5rem;
        border-top: 1px solid var(--color-white);
        padding-top: 1.8rem;
        margin-top: 1.6rem;
        @include media_max(sp) {
          display: block;
          padding-top: 1.2rem;
        }
      }
      dt {
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1.6;
        @include media_max(sp) {
          margin-bottom: 0.62rem;
          font-size: 1.4rem;
        }
      }
      dd {
        flex: 1;
        text-align: left;
        font-size: 1.4rem;
        line-height: 1.6;
      }

      &_button {
        --bg_color: var(--color-white);
        --text_color: var(--color-black02);
        --border_color: var(--color-white);
        @include media_max(sp) {
          margin-top: 1.8rem;
        }
      }
    }
  }
</style>
