---
import Img from "../utils/ImgLoader.astro";
import SectionHeader from "../ui/SectionHeader.astro";

/***   背景画像   ***/
import { getImage } from "astro:assets";
import recognitionBg from "../../assets/img/design/recognition__bg.jpg";
import recognitionBgSp from "../../assets/img/design/recognition__bg-sp.jpg";

const recognitionBgOptimized = await getImage({ src: recognitionBg, format: "webp" });
const recognitionBgSpOptimized = await getImage({ src: recognitionBgSp, format: "webp" });
---

<section
  class="recognition main_section"
  style={{
    "--recognitionBgUrl": `url(${recognitionBgOptimized.src})`,
    "--recognitionBgSpUrl": `url(${recognitionBgSpOptimized.src})`,
  }}
>
  <div class="contents_wrapper">
    <SectionHeader headingText="メディア掲載・受賞歴" imgSrc="text/recognition__heading.svg" imgWidth={340} imgAlt="RECOGNITION" align="center" />

    <h3 class="recognition__tit">
      <Img img={{ src: "text/recognition__tit.svg" }} width={340} alt="社外からの評価" />
    </h3>

    <h4 class="recognition__list_tit">受賞・選出</h4>
    <ul class="recognition__list">
      <li class="recognition__list_item">
        <div class="recognition__list_item_img_block">
          <Img
            img={{
              src: "recognition__img01.png",
              widths: [250, 200, 140],
            }}
            sizes="(max-width: 768px) 100vw, 140px"
            width={140}
            alt=""
          />
        </div>
        <div class="recognition__list_item_contents">
          <h5 class="recognition__list_item_tit">Forbes JAPAN 30 UNDER 30</h5>
          <p class="recognition__list_item_text">支援先の起業家が次世代を担う30名に選出</p>
        </div>
      </li>
      <li class="recognition__list_item">
        <div class="recognition__list_item_img_block">
          <Img
            img={{
              src: "recognition__img02.png",
              widths: [250, 200, 140],
            }}
            sizes="(max-width: 768px) 100vw, 140px"
            width={140}
            alt=""
          />
        </div>
        <div class="recognition__list_item_contents">
          <h5 class="recognition__list_item_tit">INTREPRENEURS AWARD 2024</h5>
          <p class="recognition__list_item_text">イントレプレナー支援企業として受賞</p>
        </div>
      </li>
      <li class="recognition__list_item">
        <div class="recognition__list_item_img_block">
          <Img
            img={{
              src: "recognition__img03.png",
              widths: [250, 200, 140],
            }}
            sizes="(max-width: 768px) 100vw, 140px"
            width={140}
            alt=""
          />
        </div>
        <div class="recognition__list_item_contents">
          <h5 class="recognition__list_item_tit">
            Financial Times APAC <br class="sp_only" />高成長企業
          </h5>
          <p class="recognition__list_item_text">
            IT & Software部門に5年連続選出<br />
            アジアIT＆Software部門53位／国内同12位
          </p>
        </div>
      </li>
      <li class="recognition__list_item">
        <div class="recognition__list_item_img_block">
          <Img
            img={{
              src: "recognition__img04.png",
              widths: [250, 200, 140],
            }}
            sizes="(max-width: 768px) 100vw, 140px"
            width={140}
            alt=""
          />
        </div>
        <div class="recognition__list_item_contents">
          <h5 class="recognition__list_item_tit">2025 Japan AWS Top Engineers / Jr. Champions</h5>
          <p class="recognition__list_item_text">
            AWSアドバンストティアサービスパートナーとしてエンジニア2名がダブル選出<br />（2025 Japan AWS Top Engineers+Jr.Champions）
          </p>
        </div>
      </li>
    </ul>

    <h4 class="recognition__list_tit">メディア・出版</h4>
    <ul class="recognition__list">
      <li class="recognition__list_item">
        <div class="recognition__list_item_img_block">
          <Img
            img={{
              src: "recognition__img05.png",
              widths: [250, 200, 140],
            }}
            sizes="(max-width: 768px) 100vw, 140px"
            width={140}
            alt=""
          />
        </div>
        <div class="recognition__list_item_contents">
          <h5 class="recognition__list_item_tit">
            書籍『新規事業の実行を<br class="sp_only" />加速する<br class="pc_only" />出島共創戦略』
          </h5>
          <p class="recognition__list_item_text">第2弾『深技興国』・第3弾も既刊で3冊体制</p>
        </div>
      </li>
      <li class="recognition__list_item">
        <div class="recognition__list_item_img_block">
          <Img
            img={{
              src: "recognition__img06.png",
              widths: [250, 200, 140],
            }}
            sizes="(max-width: 768px) 100vw, 140px"
            width={140}
            alt=""
          />
        </div>
        <div class="recognition__list_item_contents">
          <h5 class="recognition__list_item_tit">Amazon書籍 部門1位</h5>
          <p class="recognition__list_item_text">新規事業領域の書籍が部門ランキング1位</p>
        </div>
      </li>
      <li class="recognition__list_item">
        <div class="recognition__list_item_img_block">
          <Img
            img={{
              src: "recognition__img07.png",
              widths: [250, 200, 140],
            }}
            sizes="(max-width: 768px) 100vw, 140px"
            width={140}
            alt=""
          />
        </div>
        <div class="recognition__list_item_contents">
          <h5 class="recognition__list_item_tit">
            NewsPicks / 東洋経済 /<br class="sp_only" /> 日経ビジネス 等
          </h5>
          <p class="recognition__list_item_text">新規事業創出のリーディングカンパニーとして 特集</p>
        </div>
      </li>
      <li class="recognition__list_item">
        <div class="recognition__list_item_img_block">
          <Img
            img={{
              src: "recognition__img08.png",
              widths: [250, 200, 140],
            }}
            sizes="(max-width: 768px) 100vw, 140px"
            width={140}
            alt=""
          />
        </div>
        <div class="recognition__list_item_contents">
          <h5 class="recognition__list_item_tit">Biz/Zine にて継続連載</h5>
          <p class="recognition__list_item_text">新規事業開発の知見を継続発信</p>
        </div>
      </li>
    </ul>
  </div>
</section>

<style lang="scss">
  .recognition {
    position: relative;
    padding-top: 20rem;
    padding-bottom: 12rem;
    @include media_max(sp) {
      padding-top: 12rem;
      padding-bottom: 4.4rem;
    }

    &::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: calc(100% + 8rem);
      background-image: var(--recognitionBgUrl);
      background-size: cover;
      background-repeat: no-repeat;
      z-index: -10;
      @include media_max(sp) {
        height: 100%;
        background-image: var(--recognitionBgSpUrl);
      }
    }

    .contents_wrapper {
      max-width: 932px;
    }

    &__tit :global(img) {
      width: auto;
      height: 4.7rem;
      max-width: 100%;
      margin: 0 auto;
      object-fit: contain;
      @include media_max(sp) {
        height: 2.8rem;
      }
    }

    &__list_tit {
      width: 100%;
      padding: 0 0 1.2em;
      margin: 9.2rem auto 4.4rem;
      border-bottom: 1px solid var(--color-black01);
      font-size: 2.2rem;
      font-weight: 700;
      line-height: 1.1;
      text-align: center;
      @include media_max(sp) {
        font-size: 1.8rem;
        padding-bottom: 1em;
        margin-top: 5.1rem;
        margin-bottom: 1.6rem;
      }
    }
    &__list {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: 2rem;
      row-gap: 4.4rem;
      @include media_max(sp) {
        grid-template-columns: 1fr;
        row-gap: 1.6rem;
      }

      &_item {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        column-gap: 2.2rem;

        @include media_min(sp) {
          &:nth-of-type(2n) {
            padding-left: 4rem;
          }
        }

        @include media_max(sp) {
          align-items: flex-start;
          column-gap: 1.4rem;
        }

        &_img_block {
          overflow: hidden;
          width: 13.2rem;
          height: auto;
          aspect-ratio: 1/1;
          box-shadow: 0 0 2rem rgba(0, 0, 0, 0.1);
          border-radius: 1rem;
          @include media_max(sp) {
            border-radius: 0.8rem;
            width: 10rem;
          }

          :global(img) {
            width: 100%;
            height: auto;
            object-fit: contain;
            transform: scale(100%);
          }
        }

        &_contents {
          flex: 1;
        }

        &_tit {
          font-size: 1.6rem;
          line-height: 1.4;
          font-weight: 700;
          @include media_max(sp) {
            line-height: 1.2;
          }
        }

        &_text {
          margin-top: 0.5rem;
          font-size: 1.4rem;
          line-height: 1.7;
          @include media_max(sp) {
            line-height: 1.32;
          }
        }
      }
    }
  }
</style>
