---
import Img from "../utils/ImgLoader.astro";
import SectionHeader from "../ui/SectionHeader.astro";

/***   背景画像   ***/
import { getImage } from "astro:assets";
import bgDesignImg from "../../assets/img/design/bg_design_img05.png";

const bgDesignImgOptimized = await getImage({ src: bgDesignImg, format: "webp" });

/**
 * 企業一覧を配列で管理
 * ※ HTMLタグの記載可能
 *
 * logo: `画像パス`,
 * name: `名前`,
 * text: `テキスト`,
 */

const companys = [
  {
    logo: `ecosystem__logo001.png`,
    name: `Relic Holdings`,
    text: `グループ全体の持株会社（2021年9月設立）`,
  },
  {
    logo: `ecosystem__logo002.png`,
    name: `ENjiNE`,
    text: `クラウドファンディング構築プラットフォーム『CROWDFUNDING NETWORK Powered by ENjiNE』の運営`,
  },
  {
    logo: `ecosystem__logo003.png`,
    name: `Scalehack`,
    text: `スケールアップ・プラットフォーム事業（営業／マーケ／オペレーション／エンジニアリング）`,
  },
  {
    logo: `ecosystem__logo004.png`,
    name: `Rebootus`,
    text: `事業再生・スモールM&A支援プラットフォーム『Rebootus』『Reboo+』の運営`,
  },
  {
    logo: `ecosystem__logo005.png`,
    name: `ZERO1000 Ventures`,
    text: `起業家を発掘・育成・スピンオフするスタートアップスタジオ`,
  },
  {
    logo: `ecosystem__logo006.png`,
    name: `RUFU`,
    text: `データウェアハウス（DWH）／BIを活用したSaaSプロダクト事業（ZERO1000第1号）`,
  },
  {
    logo: `ecosystem__logo007.png`,
    name: `MEAL FORWARD`,
    text: `食品流通・購買のイノベーション事業『MEAL as a Service』（ZERO1000第2号）`,
  },
  {
    logo: `ecosystem__logo008.png`,
    name: `3rd Economy`,
    text: `ブロックチェーン技術を活用した金銭債権トークン化マーケットプレイス（Web3×FinTech）`,
  },
  {
    logo: `ecosystem__logo009.png`,
    name: `Pro3Lab`,
    text: `完全成果報酬型エンジニアリング事業。Webアプリ等の新規ソフトウェアを共同開発`,
  },
  {
    logo: `ecosystem__logo010.png`,
    name: `ALTILAN`,
    text: `宇宙機器開発および宇宙ビジネス推進。異業種・地域企業の宇宙参入を支援（浜松市・2024年設立）`,
  },
  {
    logo: `ecosystem__logo011.png`,
    name: `KEEP TECH JAPAN`,
    text: `フードテック事業を展開するシンガポール現地法人。国際特許の酸化防止技術で日本酒向けIoTサーバーを展開（2024年設立）。`,
  },
  {
    logo: `ecosystem__logo012.png`,
    name: `Relic CVC`,
    text: `CVCファンドの組成・運営／パートナー企業のCVC設立・運用支援（2023年4月設立）`,
  },
];
---

<section
  class="ecosystem main_section"
  style={{
    "--bgDesignImgUrl": `url(${bgDesignImgOptimized.src})`,
  }}
>
  <div class="ecosystem__bg"></div>
  <div class="contents_wrapper">
    <SectionHeader headingText="事業共創エコシステム" imgSrc="text/ecosystem__heading.svg" imgWidth={258} imgAlt="ECOSYSTEM" align="left" />

    <h3 class="ecosystem__tit">
      <Img img={{ src: "text/ecosystem__tit.svg" }} width={570} alt="28社体制で構成する、事業創出のエコシステム" />
    </h3>

    <p class="ecosystem__text">
      Relicは支援するだけでなく、自ら事業会社群を運営する事業共創グループ。<br />
      各領域の専門会社が連携し、貴社の事業を立ち上げ、育て、自走するまで伴走します。
    </p>

    <div class="ecosystem__list_wrapper swiper js-ecosystem_swiper">
      <ul class="ecosystem__list swiper-wrapper">
        {
          companys.map((company) => (
            <li class="ecosystem__list_item swiper-slide">
              <div class="ecosystem__list_item_img_block">
                <Img
                  img={{
                    src: company.logo,
                    widths: [530, 400, 300],
                  }}
                  sizes="(max-width: 768px) 100vw, 400px"
                  width={266}
                  alt={company.name}
                />
              </div>
              <div class="ecosystem__list_item_contents">
                <h3 class="ecosystem__list_item_name" set:html={company.name} />
                <p class="ecosystem__list_item_text" set:html={company.text} />
              </div>
            </li>
          ))
        }
      </ul>

      <div class="swiper-scrollbar sp_only"></div>
    </div>
  </div>
</section>

<style lang="scss">
  .ecosystem {
    position: relative;
    padding-top: 5rem;
    padding-bottom: 10rem;

    &::before {
      content: "";
      position: absolute;
      top: -54rem;
      right: 0;
      background-image: var(--bgDesignImgUrl);
      background-repeat: no-repeat;
      background-size: cover;
      width: 44rem;
      height: auto;
      aspect-ratio: 456/1486;
      z-index: -1;
      @include media_max(sp) {
        display: none;
      }
    }

    &__bg::before,
    &__bg::after {
      --top: -30.9rem;
      content: "";
      position: absolute;
      top: var(--top);
      left: 0;
      width: 100%;
      height: calc(100% - var(--top));
      background-position: center center;
      z-index: -10;
      @include media_max(sp) {
        --top: 0rem;
        height: calc(100%);
      }
    }
    &__bg::before {
      background-image: linear-gradient(180deg, rgba(241, 241, 241, 0) 0%, rgba(241, 241, 241, 1) 20%);
      @include media_max(sp) {
        background: #f1f1f1;
      }
    }
    &__bg::after {
      height: 106rem;
      background-color: transparent;
      background-image: linear-gradient(#f3fbfc 1px, transparent 1px), linear-gradient(90deg, #f3fbfc 1px, transparent 1px);
      background-size: 6.2rem 6.2rem;
      background-position: 0rem 3.5rem;
      opacity: 0.8;
      @include media_max(sp) {
        height: 100%;
        background-position: 0rem 0rem;
      }
    }

    &__tit :global(img) {
      width: auto;
      height: 11.2rem;
      max-width: 100%;
      margin: 0;
      object-fit: contain;
      @include media_max(sp) {
        height: 6.6rem;
      }
    }

    &__text {
      font-weight: 500;
      margin-top: 3.2rem;
      @include media_max(sp) {
        margin-top: 2rem;
      }
    }

    //　sp版 swiper
    &__list_wrapper {
      @include media_min(sp) {
        overflow: inherit;
        margin-top: 7rem;
      }
      @include media_max(sp) {
        margin-right: -2.5rem;
      }
    }
    & &__list {
      @include media_min(sp) {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        align-items: flex-start;
        column-gap: 2rem;
        row-gap: 3.5rem;
      }
      @include media_max(sp) {
        margin-top: 3.2rem;
      }
      &_item {
        width: 100%;

        &_img_block {
          margin: 0;
          border-radius: 1.4rem;
          box-shadow: 0 0 2rem rgba(0, 0, 0, 0.1);

          :global(img) {
            width: 100%;
          }
        }

        &_name {
          margin-top: 1.8rem;
          font-size: 1.8rem;
          line-height: 1.1;
        }

        &_text {
          margin-top: 0.9rem;
          font-size: 1.4rem;
          line-height: 1.5;
        }
      }
    }

    // swiepr初期化時の調整
    @include media_max(sp) {
      &__block_wrapper:not(.swiper-initialized) {
        opacity: 0;
      }
      &__block_wrapper:not(.swiper-initialized) .ecosystem__list_item:not(:first-of-type) {
        display: none;
      }
    }

    /* スクロールバーのカスタム */
    .swiper-scrollbar {
      position: static;
      background: #fff;
      width: calc(100% - 2.5rem);
      height: 5px;
      margin: 2rem 0 0;
    }
    :global(.swiper-scrollbar-drag) {
      background: var(--color-magenta01);
      border-radius: 0;
    }
  }
</style>

<script>
  // @ts-ignore
  import "swiper/css/bundle";

  // querySelectorAllに型を指定
  const sliders = document.querySelectorAll<HTMLElement>(".js-ecosystem_swiper");

  if (sliders.length > 0) {
    const mediaQuery = window.matchMedia("(max-width: 768px)");

    let swiperInstances = [];
    let isSwiperLoaded = false;
    let SwiperClass;
    let swiperModules;

    // Swiperの初期化・破棄を管理する関数
    const initSwiper = () => {
      // SPサイズの場合
      if (mediaQuery.matches) {
        // まだモジュールが読み込まれていない場合はスキップ（Observerに任せる）
        if (!isSwiperLoaded) return;

        if (swiperInstances.length === 0) {
          sliders.forEach((slider) => {
            const scrollbarEl = slider.querySelector<HTMLElement>(".swiper-scrollbar");

            const instance = new SwiperClass(slider, {
              modules: swiperModules,
              mousewheel: {
                forceToAxis: true,
                sensitivity: 0.9,
              },
              freeMode: true,
              touchRatio: 0.7,
              autoHeight: false,
              loop: false,
              slidesPerView: 1.4,
              speed: 500,
              spaceBetween: "5.4%",
              scrollbar: scrollbarEl
                ? {
                    el: scrollbarEl,
                    draggable: true,
                  }
                : false,
            });

            swiperInstances.push(instance);
          });
        }
      }
      // PCサイズの場合
      else {
        if (swiperInstances.length > 0) {
          swiperInstances.forEach((instance) => {
            instance.destroy(true, true);
          });
          swiperInstances = [];
        }
      }
    };

    // 画面スクロールに応じた遅延読み込みの設定
    const observer = new IntersectionObserver(
      async (entries, obs) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          obs.disconnect(); // 監視を解除

          // まだ読み込まれていなければ、画面に入ったタイミングでインポート
          if (!isSwiperLoaded) {
            // @ts-ignore
            const { default: Swiper, Navigation, Autoplay, EffectFade, Scrollbar, Mousewheel, FreeMode } = await import("swiper");

            SwiperClass = Swiper;
            swiperModules = [Navigation, Autoplay, EffectFade, Scrollbar, Mousewheel, FreeMode];
            isSwiperLoaded = true;
          }

          // 読み込み完了後に初期化判定を実行
          initSwiper();
        }
      },
      { rootMargin: "300px 0px" }, // 画面に入る300px手前でロード開始
    );

    // 全てのスライダーを監視対象に追加
    sliders.forEach((slider) => {
      observer.observe(slider);
    });

    // リサイズイベントのハンドリング
    mediaQuery.addEventListener("change", initSwiper);
  }
</script>
