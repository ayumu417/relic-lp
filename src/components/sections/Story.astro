---
import Img from "../utils/ImgLoader.astro";
import Button from "../ui/Button.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import Cta from "../block/Cta.astro";

/***   背景画像   ***/
import { getImage } from "astro:assets";
import bgDesignImg from "../../assets/img/design/bg_design_img04.png";

// 背景画像の最適化（WebP変換）処理
const bgDesignImgOptimized = await getImage({ src: bgDesignImg, format: "webp" });
---

<!-- 挑戦の物語（STORY）セクション -->
<section
  id="story"
  class="story main_section"
  style={{
    "--bgDesignImgUrl": `url(${bgDesignImgOptimized.src})`,
  }}
>
  <div class="contents_wrapper">
    <!-- セクションヘッダー（右寄せ） -->
    <SectionHeader headingText="挑戦の物語" imgSrc="text/story__heading.svg" imgWidth={162} imgAlt="STORY" align="right" />

    <!-- メイン見出し画像 -->
    <h3 class="story__tit">
      <Img
        sources={[
          {
            media: "(max-width: 768px)",
            src: "text/story__tit-sp.svg",
          },
        ]}
        img={{ src: "text/story__tit.svg" }}
        width={786}
        alt="事例ではなく、`苦悩と挑戦`のストーリー"
      />
    </h3>

    <!-- リードテキスト -->
    <p class="story__text">
      単なる成果のご紹介ではなく、<br class="sp_only" />一人のご担当者様がどんな葛藤を抱え、<br class="sp_only" />Relicと共にどう突破したか。<br />
      ストーリーとしてお届けします。
    </p>

    <!-- 事例カード群（PC時:逆順段々配置 / SP時:Swiperスライダー） -->
    <div class="story__block_wrapper swiper js-service_swiper">
      <div class="story__block swiper-wrapper">
        <div class="story__block_box swiper-slide">
          <h4 class="story__block_box_tit">
            <Img img={{ src: "text/story__label_tit01.svg" }} width={82} alt="地域発の健康経営を全国へ。「Ciaeru」開発の舞台裏" />
          </h4>
          <div class="story__block_box_inner">
            <div class="story__block_box_img_block">
              <Img
                img={{
                  src: "story__img01.jpg",
                  widths: [630, 420, 350],
                }}
                sizes="(max-width: 768px) 90vw, 420px"
                width={420}
                alt=""
              />
            </div>
            <div class="story__block_box_contents">
              <p class="story__block_box_name">株式会社Canvas 様</p>
              <p class="story__block_box_text">
                健康経営支援の再現性を高める<br />
                「Ciaeru」開発とフランチャイズ<br />
                展開の基盤構築
              </p>
              <a
                href="https://relic.co.jp/dis_cases/%e5%9c%b0%e5%9f%9f%e7%99%ba%e3%81%ae%e5%81%a5%e5%ba%b7%e7%b5%8c%e5%96%b6%e3%82%92%e5%85%a8%e5%9b%bd%e3%81%b8-%e2%94%80%e2%94%80-canvas%e7%a4%be%e3%81%8crelic%e3%81%a8%e6%8c%91%e3%82%93%e3%81%a0/"
                class="story__block_box_link"
                target="_blank"
              >
                事例ストーリーを読む
              </a>
            </div>
          </div>
        </div>

        <div class="story__block_box swiper-slide">
          <h4 class="story__block_box_tit">
            <Img img={{ src: "text/story__label_tit02.svg" }} width={82} alt="構想が固まらないところから始まった新規事業" />
          </h4>
          <div class="story__block_box_inner">
            <div class="story__block_box_img_block">
              <Img
                img={{
                  src: "story__img02.jpg",
                  widths: [630, 420, 350],
                }}
                sizes="(max-width: 768px) 90vw, 420px"
                width={420}
                alt=""
              />
            </div>
            <div class="story__block_box_contents">
              <p class="story__block_box_name">LDT株式会社 様</p>
              <p class="story__block_box_text">
                構想初期からの不確実性を <br />乗り越えた「マッチドライブ」<br class="sp_only" />立ち上げ
              </p>
              <a
                href="https://relic.co.jp/dis_cases/%e6%a7%8b%e6%83%b3%e3%81%8c%e5%9b%ba%e3%81%be%e3%82%89%e3%81%aa%e3%81%84%e3%81%a8%e3%81%93%e3%82%8d%e3%81%8b%e3%82%89%e5%a7%8b%e3%81%be%e3%81%a3%e3%81%9f%e6%96%b0%e8%a6%8f%e4%ba%8b%e6%a5%ad%e2%94%80/"
                class="story__block_box_link"
                target="_blank"
              >
                事例ストーリーを読む
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- SP用ページネーション -->
      <div class="swiper-pagination sp_only"></div>
    </div>

    <!-- 事例一覧ボタン -->
    <Button class="story__button" href="https://relic.co.jp/services/dis/" target="_blank" rel="noopener noreferrer" color="beige"> すべての事例ストーリーを読む </Button>
  </div>

  <!-- 下部オーバーラップ表示するCTAコンポーネント -->
  <Cta />
</section>

<style lang="scss">
  /* STORYセクション全体のスタイル */
  .story {
    position: relative;
    padding-top: 10.6rem;
    padding-bottom: 19rem;
    @include media_max(sp) {
      padding-top: 8.7rem;
      padding-bottom: 12rem;
    }

    /* 左側の背景装飾画像 */
    &::after {
      content: "";
      position: absolute;
      top: -22rem;
      left: 0;
      background-image: var(--bgDesignImgUrl);
      background-repeat: no-repeat;
      background-size: cover;
      width: 48.7rem;
      height: auto;
      aspect-ratio: 495/1627;
      z-index: -1;
      @include media_max(sp) {
        top: -13.2rem;
        width: 13rem;
      }
    }

    &__tit :global(img) {
      width: auto;
      height: 4.7rem;
      max-width: 100%;
      margin: 0 0 0 auto;
      object-fit: contain;
      @include media_max(sp) {
        height: 6.2rem;
      }
    }

    :global(.section_header)::after {
      background: var(--color-black02);
    }

    &__text {
      margin: 2.8rem 0 0;
      text-align: right;
      font-weight: 500;
      @include media_max(sp) {
        margin-top: 1.5rem;
      }
    }

    &__button {
      margin-top: 2.5rem;
      margin-right: 0;
      @include media_max(sp) {
        margin-top: 4rem;
        margin-left: auto;
        margin-right: auto;
        padding-right: 1.4em;
      }
    }

    /* SP版Swiperスライダー用エリア設定 */
    &__block_wrapper {
      @include media_min(sp) {
        overflow: inherit;
      }
      @include media_max(sp) {
        margin-left: -2.5rem;
        margin-right: -2.5rem;
      }
    }

    /* PC時: 逆順（flex-direction: row-reverse）で右から配置し、2枚目を下にずらす */
    &__block {
      margin-top: 8.7rem;
      @include media_min(sp) {
        display: flex;
        flex-direction: row-reverse;
        align-items: flex-start;
        column-gap: 4rem;
      }
      @include media_max(sp) {
        margin-top: 4.4rem;
      }

      &_box {
        position: relative;
        @include media_min(sp) {
          width: 42rem;

          /* 2枚目以降のカードを下にずらしてレイアウトに動きを出す */
          &:nth-of-type(n + 2) {
            margin-top: 7.7rem;
          }
        }
        @include media_max(sp) {
          width: 34rem;
        }
        &_inner {
          padding: 0;
          overflow: hidden;
          border-radius: 1.4rem;
          box-shadow: 0 0 2rem rgba(0, 0, 0, 0.1);
        }

        &_img_block :global(img) {
          width: 100%;
        }

        /* 右上バッジの絶対配置設定 */
        &_tit {
          position: absolute;
          top: -4rem;
          right: -1.9rem;
          width: 8.4rem;
          @include media_max(sp) {
            top: -2rem;
            right: -1rem;
            width: 7rem;
          }
        }

        &_contents {
          padding: 3rem 4rem 5.5rem;
          @include media_max(sp) {
            padding: 2.2rem 2.4rem 4.6rem;
          }
        }
        &_name {
          margin-bottom: 1rem;
          color: var(--color-deep_blue01);
          font-size: 1.4rem;
          font-weight: 700;
          line-height: 1.2;
        }
        &_text {
          color: var(--color-black01);
          font-size: 1.9rem;
          font-weight: 700;
          font-family: var(--font-noto_serif);
          letter-spacing: -0.02em;
          line-height: 1.45;
        }

        /* 下線矢印付きのリンク（ホバー時に右へスライド） */
        &_link {
          position: relative;
          display: block;
          margin-top: 2.4rem;
          width: 25rem;
          font-weight: 700;
          line-height: 1.6;
          padding-bottom: 0.15em;
          padding-right: 2.5rem;
          @include media_max(sp) {
            margin-top: 1.9rem;
          }

          /* SVGの下線矢印アイコン */
          &::after {
            content: "";
            position: absolute;
            top: 100%;
            left: 0;
            background-image: url(../../assets/img/icon/story__link_arrow.svg);
            background-repeat: no-repeat;
            background-size: 100% 100%;
            width: 100%;
            height: auto;
            aspect-ratio: 253/9;
            transition: 0.1s ease;
            transform-origin: bottom left;
          }

          /* ホバー時に右へ移動 */
          &:hover::after {
            transform: translateX(1em);
          }
        }
      }
    }

    /* Swiper初期化前の1枚目以外のカード非表示制御 */
    @include media_max(sp) {
      &__block_wrapper:not(.swiper-initialized) {
        opacity: 0;
      }
      &__block_wrapper:not(.swiper-initialized) .story__block_box:not(:first-of-type) {
        display: none;
      }
    }

    /* セクション下部にCTAを半分重なる形で配置 */
    :global(.cta) {
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%) translateY(50%);
    }
  }
</style>

<script>
  import { setupResponsiveSwiperSp } from "../../assets/js/setupSwiperSp";

  // SP用事例スライダー初期化関数の呼び出し（表示比率と間隔を指定）
  setupResponsiveSwiperSp(".js-service_swiper", "1.12", "14%");
</script>