---
import Img from "./ImgLoader.astro";
---

<section class="faq_sec main_sec">
  <div class="contents_wrapper">
    <div class="heading_block heading_block--center">
      <h2 class="heading_block__heading">
        <Img img={{ src: "text/faq__heading.svg" }} width={91} alt="FAQ" />
      </h2>
      <p class="heading_block__lead">よくあるご質問</p>
    </div>
    <p class="faq_sec__emphasized_text">
      <Img
        img={{ src: "text/faq__emphasized_text.svg" }}
        width={325}
        alt="よくいただくご質問"
      />
    </p>

    <dl class="faq_sec__list">
      <div class="faq_sec__list_item js-acc_wrapper">
        <dt class="faq_sec__list_item_head js-acc_switch">
          <p>「出島スキーム」とは具体的に<br class="sp_only">どんな仕組みですか？</p>
        </dt>
        <dd class="faq_sec__list_item_contents js-acc_target">
          <div class="faq_sec__list_item_contents_inner">
            <p>
              貴社の看板を一時的に外に置くことで、レビュテーションリスクを抑えながら、仮説検証を高速で回せます。検証が進んだ後で貴社に事業を戻す、JV化する、カーブアウトするなど、出口設計も含めてご相談に応じます。
            </p>
          </div>
        </dd>
      </div>
      <div class="faq_sec__list_item js-acc_wrapper">
        <dt class="faq_sec__list_item_head js-acc_switch">
          <p>支援期間はどれくらいですか？</p>
        </dt>
        <dd class="faq_sec__list_item_contents js-acc_target">
          <div class="faq_sec__list_item_contents_inner">
            <p>
              最短3ヶ月から、長期は数年単位までご支援可能です。事業フェーズと目標に応じてご相談ください。
            </p>
          </div>
        </dd>
      </div>
      <div class="faq_sec__list_item js-acc_wrapper">
        <dt class="faq_sec__list_item_head js-acc_switch">
          <p>費用感の目安は？</p>
        </dt>
        <dd class="faq_sec__list_item_contents js-acc_target">
          <div class="faq_sec__list_item_contents_inner">
            <p>
              支援内容・体制規模により異なります。月額型・成果報酬型・JV型・CVC型など、グループ各社の機能を組み合わせた柔軟な契約形態に対応しています。
            </p>
          </div>
        </dd>
      </div>
      <div class="faq_sec__list_item js-acc_wrapper">
        <dt class="faq_sec__list_item_head js-acc_switch">
          <p>構想がまだ固まっていない段階でも<br class="sp_only">相談できますか？</p>
        </dt>
        <dd class="faq_sec__list_item_contents js-acc_target">
          <div class="faq_sec__list_item_contents_inner">
            <p>
              はい。むしろ構想段階からのご相談を多くいただいています。ワークショップやIDEATION
              Cloudを活用し、構想の輪郭づくりからご支援可能です。
            </p>
          </div>
        </dd>
      </div>
      <div class="faq_sec__list_item js-acc_wrapper">
        <dt class="faq_sec__list_item_head js-acc_switch">
          <p>秘密保持・コンプライアンスは？</p>
        </dt>
        <dd class="faq_sec__list_item_contents js-acc_target">
          <div class="faq_sec__list_item_contents_inner">
            <p>
              ご相談前にNDA締結が可能です。ISO/IEC
              27001認証取得済で、上場企業対応の情報管理体制を整備しています。
            </p>
          </div>
        </dd>
      </div>
      <div class="faq_sec__list_item js-acc_wrapper">
        <dt class="faq_sec__list_item_head js-acc_switch">
          <p>
            アサインされる担当者の質に不安が<br class="sp_only">あります。提案時と実際の担当が<br class="sp_only">変わったりしますか？
          </p>
        </dt>
        <dd class="faq_sec__list_item_contents js-acc_target">
          <div class="faq_sec__list_item_contents_inner">
            <p>
              ご提案時にアサインメンバーを明示し、商談段階で面談していただける運用にしています。途中でのメンバー変更も、事前のご相談なく勝手に行うことはありません。
            </p>
          </div>
        </dd>
      </div>
      <div class="faq_sec__list_item js-acc_wrapper">
        <dt class="faq_sec__list_item_head js-acc_switch">
          <p>海外展開やシンガポールでの事業<br class="sp_only">立ち上げも対応できますか</p>
        </dt>
        <dd class="faq_sec__list_item_contents js-acc_target">
          <div class="faq_sec__list_item_contents_inner">
            <p>
              可能です。シンガポール拠点（KEEP TECH
              JAPAN）を起点に、東南アジアでの事業立ち上げをご支援しています。
            </p>
          </div>
        </dd>
      </div>
      <div class="faq_sec__list_item js-acc_wrapper">
        <dt class="faq_sec__list_item_head js-acc_switch">
          <p>社内人材の育成・内製化も<br class="sp_only">依頼できますか？</p>
        </dt>
        <dd class="faq_sec__list_item_contents js-acc_target">
          <div class="faq_sec__list_item_contents_inner">
            <p>
              可能です。新規事業人材育成プログラム「Innovator's
              101」を中心に、伴走しながら内製化を進めるプログラムをご用意しています。依存と内製化のジレンマには真正面から向き合います。
            </p>
          </div>
        </dd>
      </div>
    </dl>
  </div>
</section>

<style lang="scss">
  .faq_sec {
    position: relative;

    .contents_wrapper {
      max-width: var(--wrapper-s);
    }

    &__emphasized_text :global(img) {
      width: auto;
      height: 4rem;
      max-width: 100%;
      margin: 0 auto;
      object-fit: contain;
      @include media_max(sp) {
        height: 2.8rem;
      }
    }

    &__list {
      --border: 1px solid var(--color-black01);
      border-top: var(--border);
      margin: 6rem 0 0;
      @include media_max(sp) {
        margin-top: 3.2rem;
      }
      &_item {
        --padding-left: 3.4rem;
        --padding-right: 9.6rem;
        border-bottom: var(--border);
        @include media_max(sp) {
        --padding-left: 0;
        --padding-right: 3.2rem;
        }

        &_head {
          position: relative;
          padding: 2.4rem var(--padding-right) 2.8rem var(--padding-left);
          font-size: 1.7rem;
          font-weight: 700;
          font-family: var(--font-noto_serif);
          line-height: 1.5;
          letter-spacing: -0.015em;
          cursor: pointer;
          @include media_max(sp) {
            padding: 1.8rem var(--padding-right) 2.0rem var(--padding-left);
          }

          p {
            &::before {
              content: "Q. ";
            }
          }

          &::after {
            content: "";
            position: absolute;
            top: 50%;
            right: 2rem;
            width: 0.7em;
            height: auto;
            aspect-ratio: 1/1;
            border: 2px solid var(--color-black01);
            border-top: 0;
            border-left: 0;
            transition: 0.5s ease;
            transform-origin: 50% 50%;
            transform: translateY(-80%) rotateY(30deg) rotateZ(45deg);
            @include media_max(sp) {
              width: 0.6em;
              right: 1.2rem;
            }
          }
        }

        &.active &_head::after {
          transform: translateY(-32%) rotateY(30deg) rotateZ(-135deg);
        }

        &_contents {
          position: relative;
          display: none;
          padding: 0;
          margin: 0;
          &_inner {
            transform: translateY(-0.2em);
            padding: 0 var(--padding-right) 3.2rem var(--padding-left);
            font-size: 1.4rem;
            line-height: 1.8;
            @include media_max(sp) {
              transform: translateY(-0.32em);
              padding: 0 0 2.5rem 0;
              letter-spacing: -0.02em;
            }
          }
        }
      }
    }
  }
</style>

<script>
  import * as slide from "../assets/js/lib/slide";

  /*-------------------------------------------
    アコーディオン
  -------------------------------------------*/
  (() => {
    const acc_swith = document.querySelectorAll(".js-acc_switch");
    acc_swith.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        let wrapper = e.target.closest(".js-acc_wrapper");
        if (wrapper) {
          let target = wrapper.querySelector(".js-acc_target");
          if (target) {
            let style = getComputedStyle(target);
            if (!(style.overflow == "hidden")) {
              if (style.display == "none") {
                wrapper.classList.add("active");
                target.classList.add("active");
                slide.slideDown(target, 470);
              } else {
                wrapper.classList.remove("active");
                target.classList.remove("active");
                slide.slideUp(target, 470);
              }
            }
          }
        }
      });
    });
  })();
</script>
