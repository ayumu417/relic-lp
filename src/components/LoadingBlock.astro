---
import Img from "../components/ImgLoader.astro";
---

<div class="loading_block">
  <div class="loading_block__bg">
    <div></div>
    <div></div>
    <div></div>
  </div>
  <div class="loading_block__inner">
    <div class="loading_block__icon">
      <Img
        img={{
          src: "loading_icon.gif",
        }}
        width={140}
        alt=""
      />
    </div>
    <div class="loading_block__logo">
      <Img
        img={{
          src: "logo--black.svg",
        }}
        width={130}
        alt="Suline"
      />
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    setTimeout(() => {
      const loading_block = document.querySelector(".loading_block"),
        loading_block__inner = document.querySelector(".loading_block__inner"),
        loading_block__bg = document.querySelector(".loading_block__bg");
      loading_block?.classList.add("is-fade_inner");
      loading_block__inner?.addEventListener("transitionend", (e) => {
        loading_block?.classList.add("is-fade_bg");
      });
      loading_block__bg?.addEventListener("transitionend", (e) => {
        document.body.classList.add("is-fade_loading");
      });
    }, 1400);
  });
</script>

<style lang="scss">
  .loading_block {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: transparent;
    z-index: 9990;
    pointer-events: none;

    &__inner {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      width: 100%;
      height: 100%;
      transition: opacity 1.02s;
    }
    &.is-fade_inner &__inner {
      opacity: 0;
    }

    &__icon {
      display: block;
      margin: 0 0 3.0rem;
      opacity: 0.4;
      @include media_max(sp) {
        margin-bottom: 2.5rem;
      }

      :global(img) {
        width: 17.6rem;
        @include media_max(sp) {
          width: 14rem;
        }
      }
    }

    &__logo {
      display: block;

      :global(img) {
        width: 13rem;
        @include media_max(sp) {
          width: 10.8rem;
        }
      }
    }

    &__bg {
      position: static;

      > div {
        --row_number: 3;
        position: absolute;
        top: 0;
        left: 0;
        width: calc(100% / var(--row_number) + 2px);
        height: 100%;
        background: var(--color-olive_green01);
        z-index: -1;
        transform: scale(1) translateZ(0px);
        transform-origin: left top;
        transition:
          transform 1.25s ease-in-out,
          opacity 3.2s 0.2s;
        @include media_max(sp) {
          transition:
            transform 1.32s ease-in-out,
            opacity 2.5s 0s;
        }

        &:nth-of-type(2) {
          left: calc(100% / var(--row_number) * 1 - 1px);
        }
        &:nth-of-type(3) {
          left: calc(100% / var(--row_number) * 2 - 1px);
        }
      }
    }
    &.is-fade_bg &__bg > div {
      opacity: 0;
      transform: scaleX(0);
    }
  }
</style>
