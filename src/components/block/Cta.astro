---
import Button from "../ui/Button.astro";
---

<!-- CTA (Call To Action) セクション -->
<section class="cta">
  <div class="cta__inner">
    <!-- テキストエリア -->
    <div class="cta__contents">
      <h2 class="cta__heading">新規事業のご相談、受け付けています</h2>
      <p class="cta__text">
        60分の無料相談で、現状を整理し、次の一手をご提案します。
      </p>
    </div>
    <!-- ボタンエリア -->
    <div class="cta__button_block">
      <!-- 無料相談ボタン -->
      <Button
        class="cta__button"
        href="#"
        target="_blank"
        color="black"
      >
        無料で相談する
      </Button>
      <!-- 資料・ホワイトペーパー請求ボタン -->
      <Button
        class="cta__button"
        href="https://relic.co.jp/contact_dl/"
        target="_blank"
        color="black"
      >
        資料・<br class="sp_only" />ホワイトペーパー請求
      </Button>
    </div>
  </div>
</section>

<style lang="scss">
  /* CTAセクション全体のラッパー設定 */
  .cta {
    position: relative;
    width: 100%;
    max-width: 107rem;
    margin: 0 auto;
    background: var(--color-black02);
    color: var(--color-white);
    border-radius: 1.4rem;
    overflow: hidden;
    z-index: 100;
    @include media_max(sp) {
      /* SP時は角丸を解除して全幅表示に */
      border-radius: 0;
    }

    /* 下部に18色のグラデーションラインを描画 */
    &::after {
      content: "";
      position: relative;
      display: block;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 1rem;
      background-image: linear-gradient(
        90deg,
        rgba(20, 60, 93, 1) 0%,
        rgba(22, 59, 93, 1) 17%,
        rgba(29, 57, 94, 1) 24%,
        rgba(41, 53, 96, 1) 29%,
        rgba(59, 48, 98, 1) 34%,
        rgba(82, 41, 101, 1) 38%,
        rgba(110, 33, 105, 1) 41%,
        rgba(144, 23, 110, 1) 44%,
        rgba(182, 13, 115, 1) 47%,
        rgba(227, 2, 122, 1) 50%,
        rgba(224, 40, 122, 1) 53%,
        rgba(222, 73, 122, 1) 56%,
        rgba(219, 101, 122, 1) 60%,
        rgba(218, 124, 122, 1) 64%,
        rgba(216, 142, 122, 1) 69%,
        rgba(215, 154, 122, 1) 75%,
        rgba(215, 161, 122, 1) 82%,
        rgba(215, 164, 122, 1) 100%
      );
      background-position: center center;
    }

    /* コンテンツを横並びに配置（PC時） */
    &__inner {
      display: flex;
      align-items: flex-start;
      justify-content: center;
      column-gap: 2rem;
      padding: 3.2rem 4rem 2.6rem;
      width: fit-content;
      margin: 0 auto;
      @include media_max(sp) {
        flex-direction: column;
        width: 100%;
        padding: 1.4rem 1.6rem 1.5rem;
      }
    }

    &__contents {
      @include media_min(sp) {
        flex: 1;
      }
      @include media_max(sp) {
        width: 100%;
      }
    }

    /* 見出しテキスト */
    &__heading {
      margin: 0;
      font-size: 2.1rem;
      font-family: var(--font-noto_serif);
      font-weight: 700;
      line-height: 1.4;
      letter-spacing: 0.025em;
      @include media_max(sp) {
        margin: 0 auto 0.8rem;
        font-size: 1.6rem;
        text-align: center;
      }
    }
    
    /* リードテキスト（SP時は非表示） */
    &__text {
      margin: 0.8rem 0 0;
      font-size: 1.4rem;
      font-weight: 500;
      letter-spacing: 0.03em;
      line-height: 1.4;
      @include media_max(sp) {
        display: none;
      }
    }

    /* ボタン2つのレイアウト（グリッドで等幅に） */
    &__button_block {
      grid-column: 2/3;
      grid-row: 1/3;
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: 1.4rem;
      width: 54rem;
      @include media_max(sp) {
        /* SP時はボタンの幅比率を変更 */
        grid-template-columns: 15.5rem 1fr;
        width: 100%;
      }
    }
    
    /* 各ボタンのスタイルオーバーライド */
    &__button {
      --bg_color: var(--color-white);
      --text_color: var(--color-black02);
      --border_color: var(--color-white);
      width: 100%;
      padding-left: 0.5em;
      padding-right: 0.5em;
      border-width: 1px;
       @include media_max(sp) {
        padding-right: 1.5em;
       }

      /* 2つ目のボタン（資料請求）は黒背景・白文字に反転 */
      &:nth-of-type(2) {
        --bg_color: var(--color-black02);
        --text_color: var(--color-white);
        --border_color: var(--color-white);
        @include media_min(sp) {
          padding-right: 1.5em;
        }
       @include media_max(sp) {
        padding-right: 1.7em;
       }
      }
    }
  }
</style>